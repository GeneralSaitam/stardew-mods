      "LogName": "Add Tourists"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/bookshelf.json",
      "LogName": "Add Bookshelf Books"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/newlocations.json",
      "LogName": "Add New Locations"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/cjbwarps.json",
      "LogName": "Add CJB Warps",
      "When": {
        "HasMod": "CJBok.CheatsMenu"
      }
    },
    {
      "Action": "Include",
      "FromFile": "jsons/shops.json",
      "LogName": "Add Shops"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/destinations.json",
      "LogName": "Add Stops"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/strings.json",
      "LogName": "Add Strings"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/events.json",
      "LogName": "Add Events"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/quests.json",
      "LogName": "Add Quests"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/items.json",
      "LogName": "Add Items (and quest items)"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/mail.json",
      "LogName": "Add Mail"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/blankloads.json",
      "LogName": "Add Blank Loads"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/loads.json",
      "LogName": "Add Various Loads"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/mapedits.json",
      "LogName": "Add Map Edits"
    },
    {
      "Action": "Include",
      "FromFile": "jsons/songs.json",
      "LogName": "Add New Music"
    }
