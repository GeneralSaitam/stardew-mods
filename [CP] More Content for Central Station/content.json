{
  "Format": "2.7.0",
  "ConfigSchema": {
    "OMEGAlinc_EnablePossibleSpoilerTourists": {
      "AllowValues": "true, false",
      "Default": "false",
      "Name": "{{config.OMEGAlinc_EnablePossibleSpoilerTourists.name}}",
      "Description": "{{config.OMEGAlinc_EnablePossibleSpoilerTourists.description}}",
      "Section": "OMEGAlinc_Tourists"
    },
    "OMEGAlinc_ShopsCaveStyle": {
      "AllowValues": "OMEGAlinc_regularmine, OMEGAlinc_dark, OMEGAlinc_dangerous, OMEGAlinc_desert, OMEGAlinc_desertdangerous, OMEGAlinc_desertdark, OMEGAlinc_desertdarkdangerous, OMEGAlinc_dino, OMEGAlinc_frost, OMEGAlinc_frostdangerous, OMEGAlinc_frostdark, OMEGAlinc_lava, OMEGAlinc_lavadangerous, OMEGAlinc_lavadark, OMEGAlinc_lavadarkdangerous, OMEGAlinc_quarryshaft, OMEGAlinc_slime",
      "Default": "OMEGAlinc_regularmine",
      "Name": "{{config.OMEGAlinc_ShopsCaveStyle.name}}",
      "Description": "{{config.OMEGAlinc_ShopsCaveStyle.description}}",
      "Section": "OMEGAlinc_Visual"
    }
  },
  "Changes": [
    {
      "Action": "Include",
