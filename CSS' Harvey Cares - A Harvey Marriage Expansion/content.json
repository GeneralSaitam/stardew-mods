{
  "Format": "2.7.0",
   "ConfigSchema": {
      "ShyHarvey": {
         "AllowValues": "false, random",
         "Default": "false",
         "Description": "Toggleable. When set to random, overlapping keys show either this mod or Shy Harvey's lines with a 50/50 chance.",
         "Section": "Dialogue Compatibility"
   },
      "PlusAliveHarvey": {
         "AllowValues": "false, random",
         "Default": "false",
         "Description": "Toggleable. When set to random, overlapping keys show either this mod or Plus Alive Harvey's lines with a 50/50 chance.",
         "Section": "Dialogue Compatibility"
   }
    },
  "DynamicTokens": [
    {
      "Name": "DialogueCompatibilityTokenShyHarvey",
      "Value": "true"
    },
    {
      "Name": "DialogueCompatibilityTokenShyHarvey",
      "Value": "{{Random: true, false}}",
      "When": {
        "HasMod |contains= Wink_Wonk_Wank_Wenk.ShyHarvey": true
      }
    },
    {
      "Name": "DialogueCompatibilityTokenPlusAliveHarvey",
      "Value": "true"
    },
    {
      "Name": "DialogueCompatibilityTokenPlusAliveHarvey",
      "Value": "{{Random: true, false}}",
      "When": {
        "HasMod |contains= Azurysu.PlusAliveHarvey": true
      }
    },
    {
      "Name": "GenderNeutral",
      "Value": ""
    },
    {
      "Name": "GenderNeutral",
      "Value": "_GN",
      "When": {
        "HasMod": "Hana.GNMTokens"
      }
    },
    {
      "Name": "TermOfEndearmentToken",
      "Value": "false"
    },
    {
      "Name": "TermOfEndearmentToken",
      "Value": "{{Hana.GNMTokens/TermOfEndearment}}",
      "When": {
        "HasMod": "Hana.GNMTokens"
      }
    }
  ],
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "Assets/data.json, Assets/mail.json, Assets/villagers.json, Assets/compatibility.json, Assets/passoutmail.json"
    }
  ]
}