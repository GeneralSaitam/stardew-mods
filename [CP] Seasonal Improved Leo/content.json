{
    "Format": "2.0.0",
	"ConfigSchema": {
		"Seasonal": {
			"AllowValues": "true, false",
			"Default": "true"
			},
		"Hairdo Leo" : {
			"Description": "Leo hairdo after his 6 hearts event. (Only working if 'Seasonal' is 'false')",
			"AllowValues": "true, false",
			"Default": "true"
			},
		"FixSpiritedsEveDialogue": {
			"Description": "In vanilla, Leo won't talk with you at Spirit's Eve. This changes his dialogue, so you can see his portrait.",
            "AllowValues": "true, false",
			"Default": "true"
			},
		"ParrotFriend": {
			"Description": "Gives Leo a parrot on his shoulder.",
            "AllowValues": "true, false",
			"Default": "true"
			},
		"Random ParrotFriend": {
			"Description": "Parrot randomly appears on sunny day.",
            "AllowValues": "true, false",
			"Default": "false"
			},
		},
		
	"DynamicTokens": [
		{
            "Name": "IndoorVariant", // Indoors
            "Value": "_Indoor",
            "When":
            {
                "IsOutdoors": "false"
            }
        },
        {
            "Name": "IndoorVariant", // Outdoors
            "Value": "_Outdoor",
            "When":
            {
                "IsOutdoors": "true"
            }
        },
        {
            "Name": "Festival",
            "Value": "FlowerDance",
            "When":
            {
                "DayEvent": "flower dance",
                "LocationName": "Forest, temp"
            }
        },
        {
            "Name": "Festival",
            "Value": "SpiritsEve",
            "When":
            {
                "DayEvent": "spirit's eve",
                "LocationName": "town, temp"
            }
        },
		{
			"Name": "OverlayParrot - Mainland",
			"Value": "OverlayParrot",
			"When": 
			{
				"LocationContext": "Valley",
				"Season": "spring, summer, fall",
				"Weather: valley": "sun, wind",
			}
		},
		{
			"Name": "OverlayParrot - Mainland",
			"Value": "OverlayParrot_Winter",
			"When": 
			{
				"LocationContext": "Valley",
				"Season": "winter",
				"Weather: valley": "sun, wind",
				"Seasonal": true
			}
		},
		{
			"Name": "OverlayParrot - Island",
			"Value": "OverlayParrot",
			"When": 
			{
				"LocationContext": "Island",
				"Season": "spring, summer, fall, winter",
				"Weather: island": "sun, wind",
			}
		},

    ],
		
    "Changes": [
		{
			"Action": "Include",
			"FromFile": "data/non-seasonal.json",
			"When": {
				"Seasonal": false
			}
		},
		{
			"Action": "Include",
			"FromFile": "data/seasonal.json",
			"When": {
				"Seasonal": true
			}
		},
		{
			"Action": "Include",
			"FromFile": "data/parrotfriend.json",
			"When": {
				"ParrotFriend": true
			}
		},
		
	/****************
