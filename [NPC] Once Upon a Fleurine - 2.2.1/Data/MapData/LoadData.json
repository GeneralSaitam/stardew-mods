{
    "Changes": [

        {
            "LogName": "Fleurine's Map Loads",
            "Action": "Load",
            "Target": "Maps/Interiors/totsFleurineInterior, Maps/Interiors/FleurineSpouseRoom, Maps/Exteriors/FleurineSpousePatio",
            "FromFile": "Assets/{{Target}}.tmx"
        },

        {
            "LogName": "Fleurine's Location Data",
            "Action": "EditData",
            "Target": "Data/Locations",
            "Entries": {
                "totsFleurineInterior": {
                    "DisplayName": "{{i18n:OUAF.Location.Tower}}",
                    "CreateOnLoad": {
                        "MapPath": "Maps/Interiors/totsFleurineInterior"
                    },
                    "ExcludeFromNpcPathfinding": false
                }
            }
        },

        {
            "LogName": "Fleurine's Map Patch",
            "Action": "EditMap",
            "Target": "Maps/Forest",
            "PatchMode": "Replace",
            "FromFile": "Assets/Maps/Exteriors/totsFleurine_towerext.tmx",
            "FromArea": {
                "X": "0",
                "Y": "0",
                "Width": "9",
                "Height": "19"
            },
            "When": {
                "HasMod|contains=FlashShifter.StardewValleyExpandedCP": "false"
            },
            "ToArea": {
                "X": "94",
                "Y": "54",
                "Width": "9",
                "Height": "19"
            }
        },
        //SVE Patch
        {
            "LogName": "Fleurine's Map Patch SVE",
            "Action": "EditMap",
            "Target": "Maps/Forest",
            "PatchMode": "Replace",
            "FromFile": "Assets/Maps/Exteriors/SVE.tmx",
            "FromArea": {
                "X": "8",
                "Y": "0",
                "Width": "8",
                "Height": "13"
            },
            "When": {
                "HasMod|contains=FlashShifter.StardewValleyExpandedCP": "true"
            },
            "ToArea": {
                "X": "103",
                "Y": "53",
                "Width": "8",
                "Height": "13"
            }
        },

        //World Map tooltip for Fleurine's Tower
        {
            "LogName": "Fleurine's Tower World Map",
            "Action": "EditData",
            "Target": "Data/WorldMap",
            "TargetField": [ "Valley", "MapAreas" ],
            "Entries": {
                "totsFleurine_TowerMap": {
                    "Id": "totsFleurine_TowerMap",
                    "PixelArea": { "X": 109, "Y": 121, "Width": 8, "Height": 13 },
                    "Textures": [
                        {
                            "Id": "totsFleurine_TowerIcon",
                            "Texture": "{{InternalAssetKey: Assets/Maps/Exteriors/FleurineTower_WorldMap.png}}",
                            "SourceRect": { "X": 0, "Y": 0, "Width": 8, "Height": 13 }
                        }
                    ],
                    "Tooltips": [
                        {
                            "Id": "totsFleurine_Tower",
                            "Text": "Fleurine's Tower",
                            "PixelArea": { "X": 109, "Y": 121, "Width": 8, "Height": 13 }
                        }
                    ]
                }
            }
        }
    ]
}