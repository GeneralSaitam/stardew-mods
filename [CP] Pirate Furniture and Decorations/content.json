	    {
	        "Action": "EditData",
	        "Target": "sophie.Calcifer/FurnitureActions",
	        "Entries": {
	            "(F){{CatItemName}}": {
	                "TileActions": [
	                    {
	                        "TileAction": "OpenShop {{CatShopId}}"
	                    }
	                ]
	            }
	        }
	    },
	    // Add  Catalogue to Seller's Shop
