			"When": {
				"Cabin MailBox Style": "Metal&Wood01, Metal&Wood02, Metal&Wood03, Metal&Wood04, Metal&Wood05"
			}
		},
		{
			"Name": "Seasonal Off",
			"Value": "{{NoSeasonal}}"
		},
		{
			"Name": "FarmMailBoxStyle",
			"Value": "{{Farm MailBox Style}}"
