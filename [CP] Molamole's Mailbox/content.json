{
	"Format": "2.7.2",
	"ConfigSchema": {
		//Farm MailBox
		"Farm MailBox Style": {
			"AllowValues": "Wood01, Wood02, Wood03, Wood04, Wood05, Metal01, Metal02, Metal03, Metal04, Metal05, Stone01, Stone02, Stone03, Stone04, Stone05",
			"Default": "Wood01",
			"Section": "Farm MailBox"
		},
		"Color": {
			"AllowValues": "Classic, NonClassic, Light, Medium, Dark",
			"Default": "Medium",
			"Section": "Farm MailBox"
		},
		"Tile": {
			"AllowValues": "Non, Red, Green, Blue, Black",
			"Default": "Non",
			"Description": "Only for the Wood Styles and Stone05",
			"Section": "Farm MailBox"
		},
		//Island MailBox
		"Island MailBox Style": {
			"AllowValues": "Metal01, Metal02, Metal03, Metal04, Metal05, Metal&Wood01, Metal&Wood02, Metal&Wood03, Metal&Wood04, Metal&Wood05, Wood01, Wood02, Wood03, Wood04, Wood05",
			"Default": "Wood01",
			"Section": "Island MailBox"
		},
		"Base": {
			"AllowValues": "Classic, NonClassic, Light, Medium, Dark",
			"Default": "NonClassic",
			"Section": "Island MailBox"
		},
		"Paint": {
			"AllowValues": "Non, Red, Green, Blue, Black",
			"Default": "Non",
			"Description": "Only for the Wood and Metal&Wood Styles",
			"Section": "Island MailBox"
		},
		//Cabin MailBox
		"Cabin MailBox Style": {
			"AllowValues": "Metal01, Metal02, Metal03, Metal04, Metal05, Metal&Wood01, Metal&Wood02, Metal&Wood03, Metal&Wood04, Metal&Wood05",
			"Default": "Metal&Wood01",
			"Section": "Cabin MailBox"
		},
		"Base02": {
			"AllowValues": "Classic, NonClassic, Light, Medium, Dark",
			"Default": "Medium",
			"Section": "Cabin MailBox"
		},
		"Paint02": {
			"AllowValues": "Non, Red, Green, Blue, Black",
			"Default": "Non",
			"Description": "Only for the Metal&Wood Styles",
			"Section": "Cabin MailBox"
		},
		//Other
		"NoSeasonal": {
			"AllowValues": "true, false",
			"Default": false,
			"Section": "Other"
		},
		"Farm Randomness": {
			"AllowValues": "true, false",
			"Default": false,
			"Section": "Farm MailBox"
		},
		"Island Randomness": {
			"AllowValues": "true, false",
			"Default": false,
			"Section": "Island MailBox"
		},
		"Use the Desaturated version?": {
			"AllowValues": "true, false",
			"Default": "false",
			"Section": "Other"
		},
		"Throw salt around the mailbox?": {
			"AllowValues": "true, false",
			"Default": "false",
			"Description": "Snails stop to appear near the mailbox",
			"Section": "Other"
		}
	},
  "DynamicTokens": [
		{
			"Name": "Non",
			"Value": "{{Tile}}",
			"When": {
				"Farm MailBox Style": "Metal01, Metal02, Metal03, Metal04, Metal05, Stone01, Stone02, Stone03, Stone04",
				"Tile": "Non, Red, Green, Blue, Black"
			}
		},
		{
			"Name": "TileColor",
			"Value": "{{Tile}}",
			"When": {
				"Farm MailBox Style": "Wood01, Wood02, Wood03, Wood04, Wood05, Stone05"
			}
		},
		{
			"Name": "Non",
			"Value": "{{Paint}}",
			"When": {
				"Island MailBox Style": "Metal01, Metal02, Metal03, Metal04, Metal05",
				"Paint": "Non, Red, Green, Blue, Black"
			}
		},
		{
			"Name": "PaintColor",
			"Value": "{{Paint}}",
			"When": {
				"Island MailBox Style": "Metal&Wood01, Metal&Wood02, Metal&Wood03, Metal&Wood04, Metal&Wood05, Wood01, Wood02, Wood03, Wood04, Wood05"
