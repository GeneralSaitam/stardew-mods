{
    "Changes": [
        /*
        4 steps to in-game doors:
        Place base-game doors on your map where the custom doors will go
        Create a custom door asset
        Patch Cursors with your custom door
        Patch townInterior with your custom door
        */
        {
            //add jail doors to the map
            "Action": "EditMap",
            "Target": "Maps/{{ModId}}_Jail",
            "FromFile": "assets/Locations/JailDoors.tmx",
            "PatchMode": "Replace",
            "ToArea": {
                "X": 14,
                "Y": 9,
                "Width": 1,
                "Height": 3
            },
            "When": {
                "HasConversationTopic |contains={{ModId}}_rsColdShoulder": false,
            },
            "Update": "OnLocationChange",
            "Priority": "Late"
        },
        {
            //mark the replaced tiles as doors
            "Action": "EditMap",
            "Target": "Maps/{{ModId}}_Jail",
            "TextOperations": [
                {
                    "Operation": "Append",
                    "Target": [
                        "MapProperties",
                        "Doors"
                    ],
                    "Value": "14 11 1 838",
                    "Delimiter": " "
                }
            ],
            "Update": "OnLocationChange",
            "Priority": "Late"
        },
        {
            //patch cursors with custom door
            "Action": "EditImage",
            "Target": "LooseSprites/Cursors",
            "FromFile": "assets/Locations/JailDoors.png",
            "FromArea": {
                "X": 0,
                "Y": 0,
                "Width": 64,
                "Height": 48
            },
            "ToArea": {
                "X": 576,
                "Y": 144,
                "Width": 64,
                "Height": 48
            },
            "PatchMode": "Replace",
            "When": {
                "LocationName": "{{ModId}}_Jail",
            },
            "Update": "OnLocationChange",
            "Priority": "Late"
        },
        {
            //patch towninterior with custom door
            "Action": "EditImage",
            "Target": "Maps/townInterior",
            "FromFile": "assets/Locations/JailDoors.png",
            "FromArea": {
                "X": 0,
                "Y": 0,
                "Width": 16,
                "Height": 48
            },
            "ToArea": {
                "X": 96,
                "Y": 384,
                "Width": 16,
                "Height": 48
            },
            "PatchMode": "Replace",
            "When": {
                "LocationName": "{{ModId}}_Jail",
            },
            "Update": "OnLocationChange",
            "Priority": "Late"
        },
    ]
}