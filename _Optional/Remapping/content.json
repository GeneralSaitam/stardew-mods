	//Required to make the mod work
	"DynamicTokens": [

		// PRIORITIES
		// DEAD BOY DETECTIVES x ECOSYSTEM SUPERPACK - 
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Ecosystem",
         "Value": "Ecosystem.Superpack",
         "When": {
			"HasMod: |contains=cajcbell.ESE": true,
            "HasMod: |contains=handwrittenhello.dbda": false
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Ecosystem",
         "Value": "Dead.Boy.Detectives",
         "When": {
			"HasMod: |contains=cajcbell.ESE": false,
            "HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Ecosystem",
         "Value": "{{RMP Priorities Dead.Boy.Detectives x Ecosystem.Superpack}}",
         "When": {
			"HasMod: |contains=cajcbell.ESE": true,
            "HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},

		// DEAD BOY DETECTIVES x ISLAND (SBV)
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Isla.SBV",
         "Value": "Isla",
         "When": {
			"HasMod: |contains=PaperNautilus.Isla": true,
			"HasMod: |contains=skellady.SBVCP": true,
			"HasMod: |contains=handwrittenhello.dbda": false
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Isla.SBV",
         "Value": "Dead.Boy.Detectives",
         "When": {
			"HasMod: |contains=PaperNautilus.Isla": false,
			"HasMod: |contains=skellady.SBVCP": false,
			"HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Isla.SBV",
         "Value": "Dead.Boy.Detectives",
         "When": {
			"HasMod: |contains=PaperNautilus.Isla": false,
			"HasMod: |contains=skellady.SBVCP": true,
			"HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Isla.SBV",
         "Value": "Dead.Boy.Detectives",
         "When": {
			"HasMod: |contains=PaperNautilus.Isla": true,
			"HasMod: |contains=skellady.SBVCP": false,
			"HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},
		{
         "Name": "RMP.PRIORITIES.BoyDetectives.Isla.SBV",
         "Value": "{{RMP Priorities Dead.Boy.Detectives x Isla.Sunberry.Village}}",
         "When": {
			"HasMod: |contains=PaperNautilus.Isla": true,
			"HasMod: |contains=skellady.SBVCP": true,
			"HasMod: |contains=handwrittenhello.dbda": true
        	}
    	},

		// GAME CONDITIONS
		// SOURCE - Activates Vanilla style if Stardew Valley Expanded is NOT installed
		{
         "Name": "RMP.Source",
         "Value": "Vanilla",
         "When": { 
            "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": false
        	}
    	},
		{
         "Name": "RMP.Source",
         "Value": "SVE",
         "When": { 
            "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": true
        	}
       	},
	   
	  	//SEASONS - Default season to prevent main menu errors
	   	{
         "Name": "RMP.Season",
         "Value": "spring"
    	},
	   	{
         "Name": "RMP.Season",
         "Value": "spring",
         "When": { 
            "Season": "spring"
        	}
    	},
		{
         "Name": "RMP.Season",
         "Value": "summer",
         "When": { 
            "Season": "summer"
        	}
    	},
		{
         "Name": "RMP.Season",
         "Value": "fall",
         "When": { 
            "Season": "fall"
        	}
    	},
		{
         "Name": "RMP.Season",
         "Value": "winter",
         "When": { 
            "Season": "winter"
        	}
    	},

	   //HALEY BAKERY - Identify the current property condition (old or new).
	   {
         "Name": "RMP.HaleyBakery.State",
         "Value": "Velho",
         "When": { 
			"HasMod: |contains=kabulla.bakery": true
        	}
       },
	   {
         "Name": "RMP.HaleyBakery.State",
         "Value": "Velho",
         "When": { 
			"HasMod: |contains=kabulla.bakery": true,
            "HasSeenEvent: anyPlayer|contains=80801010": false
        	}
       },
	   {
         "Name": "RMP.HaleyBakery.State",
         "Value": "Novo",
         "When": {
			"HasMod: |contains=kabulla.bakery": true,
            "HasSeenEvent: anyPlayer|contains=80801010": true
        	}
       },

	   //FIASA - Identify which type of relationship was chosen.
	   {
         "Name": "RMP.FIASA.Bond",
         "Value": "Platonic",
         "When": { 
            "HasMod: |contains=CC.Koda.Platonic": true
        	}
       },
	   {
         "Name": "RMP.FIASA.Bond",
         "Value": "Romance",
         "When": { 
            "HasMod: |contains=CC.Koda.Romance": true
        	}
       },

	   //DEFENSE DIVISION - Identify the current property condition
	   {
         "Name": "RMP.DD.House",
         "Value": "Cx",
         "When": { 
			"HasSeenEvent |contains=61743015": false,
			"HasSeenEvent |contains=61743017": false,
			"HasMod: |contains=DD.DefenseDivision": true
        	}
       },
	   {
         "Name": "RMP.DD.House",
         "Value": "Loja.Comu.Cx",
         "When": {
			"HasSeenEvent |contains=61743015": true,
			"HasMod: |contains=DD.DefenseDivision": true
        	}
       },
	   {
         "Name": "RMP.DD.House",
         "Value": "Loja.Joja.Cx",
         "When": { 
			"HasSeenEvent |contains=61743017": true,
			"HasMod: |contains=DD.DefenseDivision": true
        	}
       }
	],

