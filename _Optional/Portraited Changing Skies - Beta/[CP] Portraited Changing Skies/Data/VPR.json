{
	"Changes": [
		{
			"LogName": "Portraited Changing Skies - Weathers and Locations Overlays (VPR)",
			"Action": "EditImage",
			"PatchMode": "Overlay",
			"Target": "LooseSprites/Cursors",
			"FromFile": "Assets/VPR/{{Variation}}/{{TargetWithoutPath}}.png",
			"ToArea": {
				"X": 601,
				"Y": 413,
				"Width": 78,
				"Height": 76
			},
			"Update": "OnLocationChange",
			"Priority": "Late"
		},
		{
			"LogName": "Portraited Changing Skies - Indoors Overlay (VPR)",
			"Action": "EditImage",
			"PatchMode": "Overlay",
			"Target": "LooseSprites/Cursors",
			"FromFile": "Assets/VPR/Indoors/{{TargetWithoutPath}}.png",
			"ToArea": {
				"X": 601,
				"Y": 413,
				"Width": 78,
				"Height": 76
			},
			"Update": "OnLocationChange",
			"Priority": "Late",
			"When": {
				"IndoorsOverlay": true,
				"IsOutdoors": false,
				"LocationName |contains= {{No Indoors Overlay}}": false,
				"Query: '{{LocationName}}' LIKE 'UndergroundMine%'": false,
				"Query: '{{LocationName}}' LIKE 'VolcanoDungeon%'": false
			}
		}
	]
}