                      "HasMod": "DaisyNiko.EarthyInteriors",
                      "Choose Recolor Manually":"Earthy"
         }
	},
	{
		"Name": "Recolor",
		"Value": "Rustic Country",
		"When": {
                      "HasMod": "Hesper.RusticCountrysideTownInterior",
                      "Choose Recolor Manually":"RusticCountry"
         }
	},
	{
		"Name": "Recolor",
		"Value": "Starblue",
		"When": {
                      "HasMod": "Lita.StarblueValleyUnofficial",
                      "Choose Recolor Manually":"Starblue"



         }
	},
	{
		"Name": "Recolor",
		"Value": "Earthy",
		"When": {
                      "HasMod": "DaisyNiko.EarthyInteriors",
                      "Choose Recolor Manually":"Off"
         }
	},
	{
		"Name": "Recolor",
		"Value": "Rustic Country",
		"When": {
                      "HasMod": "Hesper.RusticCountrysideTownInterior",
                      "Choose Recolor Manually":"Off"
