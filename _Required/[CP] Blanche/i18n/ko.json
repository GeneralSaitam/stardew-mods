{
    //Dispositions
    "Blanche.NPC.Name": "블랑슈",

    //Gift taste 
    "gift.love": "와, 정말 나한테 주는거야? @, 오늘 하루를 특별하게 만들어줘서 고마워.$1",
    "gift.like": "선물이라고? 고마워.",
    "gift.dislike": "독특한 취향이네.$2",
    "gift.hate": "나 이거 안 좋아해.$2",
    "gift.neutral": "고마워.",
	
	//items and desert dialogue
	"weapon.RilkePoetryCollection": "릴케 시집",
	"Blanche.Portrait": "블랑슈 초상화",
	"weapon.RilkePoetryCollection.description": "블랑슈가 즐겨 읽는 라이너 마리아 릴케의 시집(양장본)입니다. 판례상 책은 흉기가 아니라지만, 두꺼운 책 모서리에 머리를 맞으면 꽤나 아플 것 같습니다.",
	"Desert.Blanche.Seller":"여유롭게 둘러봐! 시집은 어쩌다 두 권이 생겨서 파는 중이야.",
	"DesertFestival.Blanche":"햇볕 너무 좋네, 그렇지?$1#$b#난 한 그루의 선인장처럼 광합성 중이야.$1",
	"DesertFestival.Blanche.marriage":"해골 동굴... 너무 위험해 보이는데, 갈 거면 조심해서 다녀와야 해, @.$0#$b#맞아, 물가도 조심해! 독이 있는 전갈 잉어가 산대.$6",
	"Blanche.Goldenapple.Fruit":"황금 사과",
	"Blanche.Goldenapple.FruitDescription":"'가장 아름다운 당신에게'라고 쓰여있는 황금빛 사과.",
	"Blanche.Goldenapple.Sapling":"황금 사과 나무 묘목",
	"Blanche.Goldenapple.SaplingDescription": "블랑슈가 선물한 사과 나무 묘목. 여름에 과일이 열리며, 자라기 위해서는 주변 8칸이 공백이어야 합니다. 성장하는데 28일이 소요됩니다.",
	
	//Custom call
	"Phone.Ring.Blanche1": "여보세요, @! 봄이니까 한창 열심히 농사 짓는 중이겠다, 그렇지?$0#$b#나는 봄이면 겨울 내내 쉬었던 마을 화단에 흙을 고르고, 새로 돋아나는 식물들을 돌봐.#$b#물론 혼자 하는 건 아니고, 캐롤라인이나 에블린 할머니랑 같이 가꿔. 나중에 너도 보러와. 안녕! *딸깍*$1",
	"Phone.Ring.Blanche2": "안녕, @! 다름 아니라 밖에 엄청 천둥 번개가 내리치더라고.$2#$b#이런 날은 우산보다 우비를 입는 게 좋을 것 같아. 자칫하다 우산이 피뢰침이 되어버리면 어떡해?$2#$b#음, 아무튼, 너와 네 농장에 피해가 없길 바라서 연락했어, @. 나중에 봐. *딸깍*$0",
	"Phone.Ring.Blanche3": "안녕, @. 날이 슬슬 쌀쌀해지네, 뭐 하고 있었어?$0#$b#요즘 밖에 풍경을 보니까, 단풍이 무척 예쁘더라고. 나는 단풍을 좋아하긴 하는데, 그래도 꽃을 더 좋아하는 것 같아.$1#$b#음... 다음번에는 단풍잎을 코팅해서 책갈피라도 만들어볼까봐. 좋은 생각이지? 후후, 그럼 이만 끊을게! *딸깍*$1",
	"Phone.Ring.Blanche4": "여보세요, @. 지금 눈 오는 거 알아? 춥긴 한데... 그래도 예쁘네.$1#$b#겨울에는 농사를 크게 하기 힘들다고 들었어. 한 해를 마무리하는 계절인 만큼, 너도 조금은 쉬었으면 좋겠어. 그럼 나중에 보자. *딸깍*$1",
	
	//Goldenapple Dialogue
	"Goldenapple.Wizard":"아주 흥미로운 기운을 가진 열매로군. 고대 숲의 마법이 희미하게 느껴져.",
	"Goldenapple.Abigail":"오, 금색 사과네! 예쁘다. 먹기 아까운걸?$1",
	"Goldenapple.Elliott":"고마워, 이건 그리스 신화에 나오는 황금 사과와 무척 닮았는걸.$h#$b#이 달콤한 향기를 맡으니 영감이 떠오르는데...$h",
	"Goldenapple.Haley":"*어머* \"세상에서 가장 아름다운 당신에게\"라니... 무척 감동적인 선물이야. 마음에 들어!$h",
	"Goldenapple.Penny":"오... 황금색 사과는 처음 봐요. 무척 귀해 보이는데, 제게 주시는 건가요?#$b#고마워요. 소중히 간직할게요.$h",


    //ExtraDialogue
    "playerkilled.notspouse": "@, 정신이 좀 들어?$9#$b#아, 네가 쓰러져 있더라고. 기절한 것 같아서 깰 때까지 옆에 있었어.$0#$b#앞으로는 조심해. 그러다 진짜 큰일 나겠어.$2",
    "playerkilled.spouse": "@..! @!!$6#$b#세상에, 나 알아보겠어?$6#$b#너 쓰러졌었어, 너무 놀라서 나까지 같이 쓰러질 뻔 했다고...$8#$b#심하게 안 다쳐서 다행이야. 집에 가자, 자기야.$8",
	"Summit.Event": "너를 만나기 전까지, 내 세상은 참 좁았어.$3#$b#분명 난 자유로워졌는데, 항상 무언가가 결핍된 듯 허전하고 답답했었지.\"/pause 1000/speak Blanche \"하지만 너와 같이 있으면... 아무것도 두려울게 없어, @. 무슨 말인지 알지?$1#$b#무한한 시간, 마법, 새로운 모험... 그런 것들도 너에 비하면 큰 가치가 없어.\"/pause 1000/speak Blanche \"이제 나에게 소원이 딱 하나 있다면, 그건 너와 같은 속도로 늙어가는 일이야.$3#$b#사랑해.$1",
	
	//Modify Wedding Dialogue
	"ModifyWedding.1": "@이(가) 처음 펠리컨 마을에 도착했을 때, 우리 공동체에 잘 적응할 수 있을지 아무도 몰랐습니다...#$b#하지만 오늘부로, @은(는) 우리 모두처럼 마을의 일원이 된 겁니다!$h#$b#그래서 오늘, {1}의 {0}, @와(과) 블랑슈를 결혼의 인연으로 맺어줄 수 있어 큰 영광입니다.",
	"ModifyWedding.2": "@이(가) 처음 펠리컨 마을에 도착했을 때, 우리 공동체에 잘 적응할 수 있을지 아무도 몰랐습니다...#$b#하지만 오늘부로, @은(는) 우리 모두처럼 마을의 일원이 된 겁니다!$h#$b#그래서 오늘, {1}의 {0}, @와(과) 블랑슈를 결혼의 인연으로 맺어줄 수 있어 큰 영광입니다.",
	"ModifyWedding.3": "@... 블랑슈... #$b# 펠리컨 마을의 시장으로, 그리고 지역 결혼 인장의 소지자로서, 이제 그대 둘이 남편과 아내가 되었음을 선언합니다!$h",
	"ModifyWedding.4": "@... 블랑슈... #$b# 펠리컨 마을의 시장으로, 그리고 지역 결혼 인장의 소지자로서, 이제 그대 둘이 아내와..., , 그러게요, 아내가 되었음을 선언합니다!$h",
	
    // Engagement Dialogue
    "engagement.0": "마음 같아서는 오늘 바로 식을 올리고 싶은데, 너도 나도 준비할 시간이 필요할 것 같으니까..$4#$b#나 사실 지금 너무 기뻐서 얼떨떨해. 나중에 봐.$4",
    "engagement.1": "@, 나 보러 온거야? 결혼 준비는 잘 되고 있어.$4#$b#물론, 3일 안에 드레스를 빌리려고 도시까지 다녀오긴 했지만.$2#$e#너도 많이 바쁘지?$0",
   
    //Rainy Dialogue
	"rainy.dialogue": "여기 사람들은 비 올 때 아무도 우산을 안 쓰더라?$9#$b#마니한테 이유를 물어보니까, 여기서 우산을 썼다간 인간 피뢰침이 돼 버릴 거래.$2#$e#그 말 들은 후부터 나도 안 쓰고 다녀. 차라리 감기에 걸리고 말지.$9",
	
	//Festivals
	"spring13.general":"@, 달걀 찾기 참전 한다고 했었나?$0#$b#아까 보니까 시장님네 픽업 트럭 위에도 하나 있고 쓰레기통이나 묘지 비석 근처에도 달걀이 있더라고.$0#$b#정말... 곳곳에 숨겨놨어, 루이스 시장님.$2",
	"spring24.general":"꽃 향기가 무척 좋아. 그렇지?$1#$b#축제 장식에 쓰이는 꽃은 다 주민들이 키운거야.$0#$b#물론 나도 같이 키웠지.$0",
	"summer11.general":"지난 해에는 샘이 붉은 버섯을 넣었다더라고.$9#$b#응? 나는 뭘 넣었냐고? 찰기가 부족해 보여서 곡물을 좀 넣었어.$0#$b#어쩌면 네거랑 겹칠수도 있겠다.$0",
	"summer28.general":"해파리의 춤은 내가 제일 좋아하는 축제야.$0#$b#근데 축제 이름이 해파리의 춤이 맞나? 아무튼..$2#$e#난 추위를 잘 타서 늦은 밤에는 실외로 잘 안나가는데, 오늘만큼은 꼭 참석하고 싶었어.$1",
	"fall16.general": "안녕, @. 점 보려고 온거야?$0#$b#음... 나는 점을 볼까 말까 고민중이야.$2#$e#미래가 궁금하긴 하지만, 괜히 안 좋은 말을 듣고 미리 걱정하고 싶지는 않으니까.$1",
	"fall27.general": "아, 영령제.. 이런 날은 오히려 혼자 있는게 불안해서 축제에 오긴 했는데, 그래도 불안하네.$3#$b#...혹시 느껴져, @? 각종 영혼들과 몬스터들이 분위기에 취해 힘을 얻은거야.$9#$e#그래도 사람들이 모여서 즐기는 분위기는 싫지 않아.$0",
	"winter8.general":"얼음 조각상들이 무척 훌륭하고 아름다워!$0",
	"winter25.general": "별의 만찬은 좀 춥긴해도 분위기가 정말 좋아.$1#$e#사람들이 모두 행복해보여.$1",
	"spring13.spouse":"나도 이번에 열심히 달걀에 그림 그려서 숨겨뒀어.$1#$b#내가 그린거 찾아줄래? 자세히 보면 우리 둘을 그려뒀거든.$1",
	"spring24.spouse":"자기 오늘따라 반짝반짝 빛나네..$4#$b#무도회라고 신경쓰고 온거야?$4",
	"summer11.spouse":"아, @. 수프에 뭘 넣을 예정이야? 네가 키운건 다 맛있겠지만.$1#$b#기대하고 있을게!$1",
	"summer28.spouse":"되게 아름답다, 그렇지 자기야?$1#$b#이따가 어디에서 해파리 볼거야? .....루이스 시장님 쪽에서 본다고?$6#$b#앗, 만약에 하이라이트때 옆에 내가 안보여도 너무 당황하지 마. 분명 더듬거리며 널 찾다가 포기하고 근처에서 구경하는걸테니까...$2",
	"fall16.spouse": "후.. 드디어! 어제 내가 했던 말 기억하지, @?$5#$b#피에르 콧대를 확 꺾어버려!$1",
	"fall27.spouse": "아, 자기야. 이리와. 내 옆에 있어.$2#$b#후... 너 오니까 조금 덜 불안해.$1",
	"winter8.spouse":"오늘 낚시 경연 참가해?$0#$b#분명 네가 1등일거야.$1",
	"winter25.spouse": "@, 메리 크리스마스.$1#$b#*쪽* 즐거운 축제 되길!$4",
	
	//Festivals_y2
	"spring13.general.2":"@, 달걀 찾기 참전 한다고 했었나?$0#$b#아까 보니까 나무나 건물 뒤에 살짝만 보이도록 숨겨놓았더라고.$0#$b#정말... 곳곳에 숨겨놨어, 루이스 시장님.$2",
	"spring24.general.2":"다들 무척 들떠 보이네, 봄바람도 산들거려서 너무 좋다.$1#$b#이런 축제에서는 흰색 드레스를 많이 입지만, 만약 나는 춤 추게 되면 다른 색 드레스를 입고 출 것 같아.$0",
	"summer11.general.2":"지난 해에는 스프에 쌀을 좀 넣었었는데, 이번 해에는 단호박을 넣었어.$0#$b#곡물보다 단 맛을 내니까 스프에 감칠맛을 올려주지 않을까 싶어서. 천연 감미료처럼 말이야.$1",
	"summer28.general.2":"이 축제는 여전히 쌀쌀하구나. 늦여름에 열리는게 아니었으면 나올 엄두도 못 냈을거야.$2#$e#그래도 밤바다는 참 아름다워.$1",
	"fall16.general.2": "안녕, @. 점 보려고 온거야?$0#$b#나는 이번 해에는 점을 봤는데, 점괘가 꽤 좋게 나와서 기뻐.$1#$e#아, 무슨 말을 들었냐고?$6#$b#후후, 그건 비밀이야.$1",
	"fall27.general.2": "있지, @. 상점 옆에 있는 광산 카트 말이야... 보여?$2#$b#저기를 통해서 몬스터들이 내려오진 않겠지...?$2#$e#나는 아무래도 이 근처에 있는 게 나을 것 같아. 만약이라는게 있으니까.$9",
	"winter8.general.2":"아무리 열심히 작업해도, 날이 따뜻해지면 녹아 사라지는 예술품들이라니...$2#$b#그래도 그런 과정까지 전부 예술의 한 부분인 거겠지?$0#$e#요즘에는 기록 수단이 다양해져서 다행이야. 사진을 찍어놓을 수 있잖아.$1",
	"winter25.general.2": "다양한 요리가 참 많아, 그렇지? 고르는 것도 고민되네...$1#$e#$y '@(이)라면 어떤 걸 먹어볼 것 같아?_다진 버섯으로 속을 채운 파이_오, 따뜻하고 든든할것 같네. 네 말대로 해야겠다.$1_키리쉬 케이크 한 조각_좋아, 이따가 후식으로 꼭 먹어볼게.$1_석탄 한 덩어리_...으음, 농부식 농담인거야?$2'",

	"spring24.spouse.2":"오랜만에 추는 건데, 춤 연습을 하고 올 걸 그랬나봐.$2#$e#만약 실수하더라도... 오늘 무도회에서 우리가 제일 즐거울거야!$1",
	"summer11.spouse.2":"@, 오늘 내가 스프에 뭘 넣었게?#$b#사실 루아우를 위해서 바닷가에 통발을 하나 설치했었거든.#$b#아침에 통발 안을 보니까 조개가 다양하게 잡혀서 바로 스프에 넣었어.$1#$e#자기는 스프에 뭐 넣었어?$1",
	"summer28.spouse.2":"작년에 밤바다의 해파리를 봤을 때, 꼭 밤하늘의 별처럼 보이더라.$0#$b#뭔가 소원을 들어줄 것 같지 않아?#$e#내 소원은 너와 계속 행복하게 지내는거야.$1",
	"fall16.spouse.2": "@, 농작물 전시 다 하고 나서 나랑 같이 축제 음식 먹자!$1#$b#거스가 바베큐 샌드위치랑, 병아리콩 후무스를 곁들인 버섯 리크 샌드위치를 만드는 중이야.$1",
	"fall27.spouse.2": "자기야, 미로에서 혹시 마녀의 집을 보더라도 절대 안으로 들어가지 마.$9#$b#잘못하면 다른 차원으로 넘어가 버릴 수도 있어...$2",
	"winter8.spouse.2":"*휴* @, 오늘 낚시 대회 참여하지?#$b#조금 춥긴 해도 곁에서 응원하고 싶어서 남아 있는 중이야.$1",
	"winter25.spouse.2": "@, 오늘 산타가 원하는 물건을 선물하길 바라!$1#$b#그리고 우리 가족은 행복하게 내년을 맞이하길!$1",
	
    //Movie reactions
	"movies.tree.1": "용감한 작고 어린 나무라...제목부터 무척 마음에 들어!$7",
	"movies.tree.2": "원래 진정한 나무는 여행을 위해 떠날줄도 알아야 하는 법이지.$7",
	"movies.tree.3": "최고였어! 해피엔딩인 것도 마음에 들어.$1#$b#게다가 나무를 주연으로 세울 생각을 하다니, 보기 드문 일이야.$1",
	"movies.horror.1": "으음, 포스터만 봤는데도 소름이 살짝 돋아.$9",
	"movies.horror.2": "블랑슈는 조금 창백해보입니다...",
	"movies.horror.3": "튀어나오지만 마라....튀어나오지만...$5",
	"movies.horror.4": "별로 안 무서웠어, 그렇지....?$2",
	"movies.love.1": "포스터만 봤는데도 재밌어보여!$0",
	"movies.love.2": "블랑슈의 두 눈이 초롱초롱 빛납니다!",
	"movies.love.3": "좋은 영화였어! 초대해줘서 고마워, @.$1",
	"movies.like.1": "사실 영화를 자주 보는 편이 아니라 조금 생소해.$0#$b#책을 더 많이 읽어서 말야. 그래도 재밌을것같아.$0",
	"movies.like.2": "재밌었어, 특히 결말이 마음에 들더라고.$1",
	"movies.dislike.1": "음, 만약 나 혼자였다면 안 봤을지도 몰라.$2#$b#너랑 본다는 게 의미가 있는거지.$0",
	"movies.dislike.2": "....$3",
	"movies.dislike.3": "보는 중에 졸았냐고...? 앗, 미안해.$2#$b#그런데 내 취향은 아니었어.$2",


	//Event Dialogues
	
	//2 heart Event
    "2hearts.1": "이를 어쩌지..?$2",
    "2hearts.2": "앗, @...? 안녕, 마침 잘 왔어.$0",
    "2hearts.3": "잠깐 와서 이 화초 좀 봐 줄래?$0#$b#요즘 들어 잘 자라지도 않고 싱싱해 보이지가 않아서.$9#$b#농부니까 나보다는 식물에 대해 더 잘 알 것 같아. 부탁할게.$2",
    "2hearts.4": "음, 어때? 무엇이 부족한것 같아?",
    "2hearts.5": "(이 화초는 지금도 완벽해! 더 해줄건 없겠어.)",
    "2hearts.6": "(비료가 부족한게 아닐까? 화초용 비료를 뿌려봐.)",
    "2hearts.7": "(화분을 야외로 옮겨서 햇빛과 바람을 충분히 쐬게 해줘.)",
    "2hearts.8": "...생각해보면, 야외에 있는 식물은 자연이 알아서 키워주거든. 그래서 실내에 있는 식물은 어떻게 돌봐야할지 잘 모르겠어...$9#$b#자연에 몸을 맡기면 무엇이 됐든 건강하고 자유로워지는것 같아.$0",
    "2hearts.9": "음, 내가 너무 감상적인 이야기만 한 것 같네.$2#$b#어쨌든 화초가 다시 건강해질 수 있게 노력해볼게. 오늘 신경 써줘서 고마워.$0",
    "2hearts.10": "도와줘서 고마웠어, @.$1",

	//4 heart Event-1
    "4hearts.1": "안녕, 좋은 아침이야 @.$0#$b#네 농장까진 처음 와 보는것 같네, 그렇지?$0#$b#휴, 너 생각보다 도서관에서 멀리 사는것같아.$2",
    "4hearts.2": "여기까지 온 이유는 다른게 아니고, 최근에 네가 캐롤라인의 온실에 초대받았다는 이야기를 들었어.$0#$b#나도 그 온실에 초대된 사람 중 한명이거든. 그래서, 캐롤라인한테 혹시 너랑 거기서 티타임을 가져도 되냐고 물어봤는데 흔쾌히 허락해주더라고.$1",
    "4hearts.3": "괜찮으면 오후에 온실에서 만나자, @.$1",
	
	// 4 heart Event-2
    "4hearts.4": "아, @! 왔구나.$1#$b#내가 어떻게 여기 있는지 궁금할거야...그렇지?$0",
    "4hearts.5": "여긴 너도 알다시피 캐롤라인의 개인 일광욕실인데, 여기 식물을 나도 같이 돌보거든.$0#$b#캐롤라인이랑은 마을 공동 화단을 돌보다가 친해졌는데, 덕분에 가끔 들려서 차도 마시고 이야기도 나누곤 해.$1",
    "4hearts.6": "자, 내가 방금 내린 차야. 한번 마셔볼래?$0",
    "4hearts.7": "향긋하지 않아? 잘 우려져서 그런지 쓰지도 않고.$1#$b#음, 내가 요즘 도서관을 관리하면서 화초를 돌보는 노하우를 이것저것 알아내는 중이거든.$0#$b#그리고 이런 작고 고요한 온실이면, 내가 듣고 싶은 소리도 쉽게 들을수 있을것 같았어.$3",
    "4hearts.8": "잘 들어봐... 고요한 작은 생명의 소리가 들리는 것 같지 않아?$3",
    "4hearts.9": "아, 그렇게 긴장하지마!$0#$b#난 갑자기 이상한 노래를 틀거나 묘한 그림을 보여주거나 하지 않을거야. 우린 이미 캐롤라인한테 한번 겪어봤잖아?$1",
    "4hearts.10": "난 그저 너랑 대화하며 차를 마시는 이 시간을 소중히 만끽하고 싶어.$1",
    "4hearts.11": "있지, @. 우리 이러고 있으니까 조금....",
    "4hearts.12": "(데이트 같다고?)",
    "4hearts.13": "(소꿉놀이 같다고?)",
    "4hearts.14": "(뭐 하는 짓인지 모르겠다고?)",
    "4hearts.15": "맞다. 실은 너랑 티타임 가질때 먹으려고 구워온 케이크가 있거든.$1#$b#근데 생각해보니까 네가 한창 바쁠 낮에 불러낸게 미안해서, 같이 느긋하게 먹자고는 못 하겠어.$2",
	"4hearts.16": "그래서 포장했어. 자 여기.[Custom_Blanche_Cake]$0",
	"4hearts.17": "나중에 맛있었는지 꼭 알려줘!$1",
	"4hearts.18": "우리 종종 같이 티타임 가지지 않을래? 난 되게 좋았거든.$0",
	
	// 4 heart Event-items
	"Blanche.Cake.Item": "포레누아 케이크",
	"Blanche.Cake.Description": "'블랙 포레스트'라고도 불리는 이 케이크는 진한 초콜릿의 풍미와 새콤달콤한 체리의 조합이 인상적입니다.",
	"Mail.ForetNoireCake.Body": "@,^온실에서 네게 선물했던 포레누아 케이크의 레시피야.^나중에 꼭 한 번 만들어 봐!^^-블랑슈",
    "Mail.ForetNoireCake.Title": "블랑슈의 포레누아 케이크 레시피",

    //5 heart Event
    "5hearts.1": "그렇다니까?",
    "5hearts.2": "진짜?",
    "5hearts.3": "그럴리가!",
    "5hearts.4": "진짜라니까? 내가 다리가 아프지 눈이 멀은걸까봐?$3",
    "5hearts.5": "허....이것 참.$2",
    "5hearts.6": "아가, 마침 잘 왔단다.$0#$b#와서 이 늙은이들이 입씨름 하는 것좀 말려주겠니? 미안하구나.$0",
    "5hearts.7": "마침 잘 왔어, 농부 양반!$0#$b#와서 두 눈이 있으면 이것 좀 봐보라고.$0",
    "5hearts.8": "조지가 보여준 것은 오래된 흑백 사진 한 장입니다.#가족처럼 보이는 세 사람이 미소를 지으며 찍혀있습니다.",
    "5hearts.9": "앞에 사람들을 보지 말고 뒤에 지나가는 행인을 좀 봐봐!$0",
    "5hearts.10": "가족 뒤에는 모자를 쓰고 여행가방을 든 한 여인이 찍혀있습니다.#여인은 옅은 색의 땋은 머리칼을 가지고, 어두운 피부를 가지고 있습니다.",
    "5hearts.11": "농부 양반, 이 행인 누구랑 닮지 않았어?$0",
    "5hearts.12": "흥.. 하긴, 어떻게 바로 떠올리겠어.#$b#이건 내가 젊었을 적에 내 딸과 아내랑 같이 찍은 사진이야. 그러니까 지금으로부터 수십년도 더 된 사진이라고!$0",
    "5hearts.13": "그런데 뒤에 도서관에서 일하는 사서 아가씨가 떡하니 찍혔잖아! 이래도 이상한걸 모르겠어?$0",
    "5hearts.14": "그 아가씨는 사람이 아니야!$2",
    "5hearts.15": "아이고...$2",
	"5hearts.16": "자자, 진정하세요. 상식적으로 이 때 젊었던 사람이 어떻게 지금까지 젊겠습니까.$2#$b#분명 닮은 사람이거나, 아니면 친인척인게 틀림없어요!$0",
	"5hearts.17": "자, 이제 그만하고 집에 들어가요. 바쁜 사람들 붙잡아두고 미안해서 어쩌나...$0",
	"5hearts.18": "맞다니까...",
	"5hearts.19": "아이고... 저 고집불통.$0",
	"5hearts.20": "같이 좀 가요",
	"5hearts.21": "그나저나 @... 요즘 블랑슈양과 친하게 지낸다지?$0#$b#나중에 자네가 기회가 되면, 한번 물어봐줬으면 좋겠는데.$0#$b#나도 그 아가씨가 사람이 아니라거나... 그런 생각을 하는게 아니라, 시장으로서 원래 마을에 연고가 있던 주민이라면 기록을 해 둘 필요가 있기 때문이네.$2",

    //6 heart Event
    "6hearts.1": ".....그래서 힘들다는거야.$9",
    "6hearts.2": "오... 듣기만해도 긴장되고....$0#$b#흥미진진한걸?$3",
    "6hearts.3": "아, 난 심각해 죽겠는데 그런 말이 나와?$2",
    "6hearts.4": "흠흠, 그래. 이야기를 듣다보니 너에게 가장 필요한 조언이 생각났어.$0",
    "6hearts.5": "그래? 그게 뭔데?$7",
    "6hearts.6": "그 농부를 데리고 숲으로 캠핑을 오는거야.$0#$b#그러다 내가 기회를 봐서 너네를 덮칠게.$3#$b#그리고 네가 농부의 텐트로 도망치는척 하고 긴긴밤을 둘이 함께 보내는거야. 어때?$1",
    "6hearts.7": "무슨 말을 하는거야!",
    "6hearts.8": "그렇게 놀랄 필요 없어! 원래 사랑은 위기 속에서 싹트는....$2",
    "6hearts.9": "...잠깐, 누가 온 것 같아.$0",
    "6hearts.10": "@? 이 밤에 여긴 무슨 일이야?$6#$b#아.. 맞다, 여긴 네 농장 바로 밑이었지. 혹시 시끄러웠으면 미안해.$2",
    "6hearts.11": "...난 친구랑 수다 좀 떠는 참이었어.$0#$b# 저 아이가 야행성이라 밤에만 만날 수 있거든.$0",
    "6hearts.12": "여어, 안녕하신가.$2",
    "6hearts.13": "@, 동물 말이 들려? 어쩐지, 너한테서 미약하지만 안정된 마나의 흐름이 느껴지더라고.$6",
    "6hearts.14": "(무엇을 질문할까?)",
    "6hearts.15": "(너도 마법사의 포션을 마신거냐고 물어본다.)",
    "6hearts.16": "(마법사냐고 물어본다.)",
    "6hearts.17": "(어떻게 동물의 말을 알아듣냐고 물어본다.)",
    "6hearts.18": "그래, 지루한 질의응답은 이제 끝났어? 나 저 농부한테 묻고 싶은거 있는데.$0",
    "6hearts.19": "....뭐가 됐던간에 그냥 마음속에 묻어놓는게 좋지않을까.$9",
    "6hearts.20": "그럴순없지!",
    "6hearts.21": "있잖냐, 이건 내가 아는 다른 곰 이야긴데... 그 친구가 자기가 다른 곰들이랑 조금 달라서 좋아하는 곰한테 고백을 못하고 있단 말이지?$0#$b#그래서 결국 그 곰이 다른 곰을 덮치려고...$3",
	"6hearts.22": "아냐! 내가... 아니 그 곰이 언제 그런 말을 했어! 내가 말할게.$6",
    "6hearts.23": "그러던지.$0",
	"6hearts.24": ".......음, 그냥 한 귀로 듣고 흘려줘. 그래서 그 곰은 거절당하는게 무서운데도 불구하고, 어떻게 상대한테 자신의 마음을 전해야 할지 고민이래. 이상하고 우스운 고민이지?$2",
	"6hearts.25": "남의 고민을 그렇게 폄하하면 쓰나.$0",
	"6hearts.26": "나 그냥 다음에 다시 올게.$9",
	"6hearts.27": "아니야, 그럴 필요 없어. 마침 밥 먹으러 가봐야 했거든. 다음에 또 보자구.$2",
	"6hearts.28": "또 보자",
	"6hearts.29": "음, 저 아이가 사교성은 좋은데, 너무 기운이 넘쳐서 가끔 따라가기 벅차.$2",
	"6hearts.30": "있지, @. 아까 이야기는 신경쓰지마. 나도 잘 모르는 친구 이야기거든.$0",
	"6hearts.31": "(무슨 말을 건넬까?)",
	"6hearts.32": "그 곰한테 힘내라고 전해줘.",
	"6hearts.33": "그 곰한테 세상에 다른 곰은 많다고 전해줘.",
	"6hearts.34": "그 곰한테 기다리고 있다고 전해줘.",
	"6hearts.35": "...근데 이건 내 생각인데, 그 친구는 아무래도 미련곰탱이라 그냥 자기 마음 가는데로 밀고 나갈것 같아.$1",
	"6hearts.36": "이야기 들어줘서 고마워. 너도 이제 자러갈꺼지?$0#$b#조심히 들어가고, 나중에 만나자, @.$1",
	
	//8 heart Event
    "8hearts.1": "안녕, @! 여기서 만나네.$1#$b#난 도서관 행사에 쓸 압화 책갈피를 만드는 중이었어.$0#$b#요즘 도서관 이용객이 점점 줄어드는 느낌이라...$2#$b#한달 동안 제일 도서 대출을 많이 한 사람에게 책갈피를 증정하는 행사를 진행해볼까 해.$0",
    "8hearts.2": "그래서 도서관에서 일하고 있었는데, 날씨가 너무 좋은거야.$0#$b#그래서 페니한테 돗자리를 빌려서 밖에 나와서 만들고 있었어.$1",
    "8hearts.3": "(무슨 말을 건넬까?)",
    "8hearts.4": "혹시 내가 도와줄 일 있어?",
    "8hearts.5": "나도 옆에서 뭐 만들어도 돼?",
    "8hearts.6": "이거 하지 말고 나랑 놀러가지 않을래?",
    "8hearts.7": "휴, 끝났다!$1",
    "8hearts.8": "볼래? 생각보다 예쁘게 만든 것 같아.$1",
    "8hearts.9": "책갈피에는 다양한 종류의 압화가 붙어있고, 밑에는 시 한 구절이 같이 적혀있습니다.",
    "8hearts.10": "네가 만든 책갈피...",
    "8hearts.11": "정말 예쁘다!",
    "8hearts.12": "시 구절이 마음에 들어.",
    "8hearts.13": "내가 만들었으면 더 잘 만들수 있었을걸.",
    "8hearts.14": "근데 아까 옆에서 뭔가 만드는것 같던데, 뭐 만들었어, @?$0",
    "8hearts.15": "와, 이거 네가 만든거야?$10#$b#진짜 예쁘다!$11",
	"8hearts.16": ".....고마워, @. 소중히 간직할게.$11",
	"8hearts.17": "네가 만들어준 화관, 정말 마음에 들어.$0#$b#평생 생생하게 보존시키려고.$0#$b#응? 그런게 어떻게 가능하냐고?$6#$b#있어, 그런 방법이.$1",

    //10 heart Event
    "10hearts.1": "이젠 바람결에 귀를 기울여도, 요정들의 속삭임이 들리지 않아...$3",
    "10hearts.2": "안녕 @. 왠지 널 만날 수 있을 것 같았어.$0#$b#신기하게, 네가 보고싶은 날에는 꼭 네가 먼저 와 주더라고.$1",
    "10hearts.3": "혹시 괜찮으면 내 이야기를 들어줄래?",
    "10hearts.4": "물론이지.",
    "10hearts.5": "무거운 이야기면 마음의 준비가 필요할것 같은데.",
    "10hearts.6": "...예전에 너한테 도서관에 있는 화초 상태 좀 봐 달라고 했던거, 기억나?$9#$b#사실... 나는 그 아이가 왜 아픈지 알고 있었어.$9",
    "10hearts.7": "아주 미약한 목소리로, 나한테 바깥의 햇살을 느끼고 싶다고 했어.$9#$b#수돗물이 아니라 빗물을 마시고 싶다고도 했었고.$3",
    "10hearts.8": "그렇게 대화하고 있을때 네가 온거야.$0#$b#난 그때 너무 당황해서, 너한테 조언을 구하는 척 하며 말을 돌렸지.$1#$b#식물과 대화하는 사람이라니... 이상해 보일게 뻔하잖아.$2",
    "10hearts.9": "혹시 마을에 떠도는 소문, 들은적 있어? 내가 사람이 아닌 다른 무언가라거나.. 그런 이야기.$3",
    "10hearts.10": "하하, 네가 의혹을 부인해줬던건 이미 에블린 할머니에게 들어서 알고있어. 고마워.$1#$b#그래서 말하는걸 더 망설였는지도 몰라. 네 앞에서는 항상 평범한 사람으로 있고 싶었거든.$3",
    "10hearts.11": "@, 이미 눈치챘을수도 있겠지만... 난 평범한 사람이 아니야.$9#$b#나는 지금보다 훨씬 옛날, 천년도 더 된 고목이었어. 거기에 깃든 영혼이었지.$3",
    "10hearts.12": "아, 그런데 이게 말만 거창하지, 오래 살았다는것 빼고는 정말 별볼일 없어. 정말로.$6",
    "10hearts.13": "아무튼 나는... 한 자리에 서서 수 많은 계절이 오가고, 생명이 태어나고 죽는것을 봤어. 그 자리가 어디었냐면, 바로 지금 도서관이 있는 자리야.$9",
    "10hearts.14": "놀랐지? 내가 얼마나 큰 나무였는데. 지금 이 나무보다 훨씬 커다랬어!$1",
    "10hearts.15": "그런데 몇십년.. 그리고 몇백년이 지나니까 사람들이 내가 있는 이곳까지 들어와 살기 시작했어.$3#$b#사람들이 점점 많아지니까, 어느 날 사람들은 자신들이 쓸 공공시설을 짓고 싶어했지.$3#$b#그리고는 내가 머물던 나무를 베어내고 그 목재로, 그 자리에 도서관을 지은거야.$9",
    "10hearts.16": "괜찮아, 우리 같이 어딘가에 깃드는 혼들은 머물던 것이 사라져도 죽지 않아.$0#$b#그저 잠깐 잠들듯 눈 앞이 어두워졌다 깨어나니까, 내 모습이 마치 사람처럼 변했더라고.$0",
    "10hearts.17": "지금 이 모습으로!",
    "10hearts.18": "덕분에 처음으로 이 마을을 떠나 세상을 여행할 수 있었어. 항상 한 군데에 머무르기만 했었던 터라, 다양한 풍경을 직접 보고 싶었으니까.$0",
    "10hearts.19": "그런데, 처음 내 발로 둘러본 세상은 활기차고, 다양하고, 넓었지만.. 반대로 시끄럽고, 두렵고, 늘 불안정했어.$3#$b#처음에는 사람들 사이에 섞여 살고 싶어서 내가 할 수 있는 모든 노력은 다 해봤지만, 이곳이 갈수록 그리워졌어.$3#$b#그래서 결국엔 돌아왔지. 비록 내 나무는 사라졌지만, 남아있는 힘을 사용해서 숲을 돌봐주자고 생각했어.$9",
    "10hearts.20": "그런데 이제는.... 자연이 속삭이는 소리가 들리지 않아. 그 때 너랑 돌봐준 친구를 마지막으로 더 이상 아무런 속삭임도 들리지 않더라.$3",
    "10hearts.21": "옛날에는 모든게 다 들렸어. 해가 떠서 저무는 소리, 나비의 날갯짓 소리, 풀 숲 사이 사이에 숨어있던 요정들의 숨소리까지.$9",
    "10hearts.22": "그래서 우울했던거야. 나는 어느 순간부터 완전히 옛날의 나와 이별했나봐.$0",
    "10hearts.23": "그래도 내가 있잖아.",
    "10hearts.24": "혹시 짚이는 이유라도 있어?",
	"10hearts.25": "사실, 그래. 지금 너와 마주보고 있으니 확신할수 있어.$4#$b#널 좋아해, @.... 이 사실이 날 불완전한 존재에서 완전한 사람으로 만들어 준거야.$4",
	"10hearts.26": "그리고 도서관으로 변한 내 옛 몸 안에서 지내면서 생각한건데, 예전에는 내 주변에 아이들 웃음소리 같은건 들리지 않았거든.$0#$b#그런데 이제는 아이들이 그곳에서 공부도 하고 책도 보며 지낸다고 생각하니까, 오히려 더 좋은 것 같아.$1",
	"10hearts.27": "그래서 지금은 기뻐. 정말로.$1",
	"10hearts.28": "누군가에게 이 이야기를 하게 될거라고는 상상도 못했어...$0",
	"10hearts.29": "@... 내가 비록 처음부터 사람이 아니라서, 가끔은 낯설게 느껴질지도 몰라.$3#$b#그래도 지금까지 열심히 노력했어. 이제는 너랑 있고 싶어서 노력하는 중이야.$0",
	"10hearts.30": "내 곁에 계속 있어줄래?$1",
	"10hearts.31": "아, @.... 무슨 일이야?$4#$b#음? 미처 못 물어본 걸 물어보러 왔다고? 그게 뭔데?$6#$b#아, 여행하면서 뭘 했었냐고? 당연히 조금 여행하다가 결국 자리 잡고, 신분 만들고, 돈 벌고 공부했지.$1#$b#...내가 너무 환상을 깼나..? 근데 사람들 사이에서 살려면 그런게 필수더라고.$2#$b#그래도 그 덕에 사서로 취직해서 널 만났으니, 의미 있는 일이었어.$1",

    //14 heart Event -1
    "14hearts.1": "@, 어서와. 사실 네가 오면 할 말이 있었어.$1",
    "14hearts.2": "이미 봤겠지만... 야외에 있는 내 작은 공간에 온실이 있는 거 알지?$0#$b#그곳에서 기다리고 있을게.#$b#오후 세 시 전까지, 시간 되면 한 번 들러줘!$1",
	//14 heart Event -2
	"14hearts.3": "흐음~ 음, 음...$0",
	"14hearts.4": "블랑슈는 조용히 허밍하고 있습니다.",
	"14hearts.5": "....즐거워 보이지만, 아직 당신이 온 줄 모르는 것 같습니다.",
	"14hearts.6": "왔구나, @. 내 작은 온실에 어서와!$1",
	"14hearts.7": "그 좁은 공간에 어떻게 이런 넓은 온실을 만든거야?",
	"14hearts.8": "캐롤라인의 일광욕실이 떠오르는 곳이네.",
	"14hearts.9": "작지만 아름다운 공간인걸.",
	"14hearts.10": "나는 네가 내 공간에 오는 건 언제나 환영이니까, 부담 없이 들러줘.",
	"14hearts.11": "아, 그런데 아마 작은 친구들... 그러니까 풀벌레나 개구리, 달팽이 같은 동물들도 여기에 들릴 수 있을 것 같아.$6#$b#그리고 어쩌면, 주니모들도.$0",
	"14hearts.12": "그리스 신화 알아, @?$0#$b#아주 까마득한... 어쩌면 내가 태어나기도 전의 고대부터 전승된 이야기를 읽는건 무척 흥미로워.$3#$b#너도 알다시피, 보통 나보다 오래된 것들은 별로 없거든.$2",
	"14hearts.13": "그렇게 오랜 시간동안 사람들에게서 잊혀지지 않고 전해졌다니, 신기하지 않아?$0#$b#시간이 지나도 누군가에게 기억된다는 것은 무척 멋진 일이야.$0#$b#내가 책을 좋아하는 이유이기도 하고. 책은 과거의 유산을 현재로 전해주잖아.$1",
	"14hearts.14": "실은, 이전에 네게 말했듯이 이제 나에게는 그렇게 큰 마나는 남아 있지 않아.$3",
	"14hearts.15": "그래서 고민을 해 봤어. 어떻게 해야 이 약간의 마나로, 네게 의미 있는 선물을 줄 수 있을지 말야.$3",
	"14hearts.16": "내 남은 힘을 실어서 무언가를 만든다면, 되도록이면 기억에 오래 남는 것으로 만들고 싶었어.$0#$b#농부인 네게 어울리고, 바라보면 내가 떠오를 수 있는, 특별한 무언가를.$0",
	"14hearts.17": "후후, 내가 어떤 걸 만들었을 것 같아?$1",
	"14hearts.18": "나무",
	"14hearts.19": "꽃",
	"14hearts.20": "책",
	"14hearts.21": "정답은 나무야, @.$1",
	"14hearts.22": "내가 네게 정체를 밝혔던 날, 기억나?$0#$b#그때부터 지금까지 너는 아무런 의심도 없이, 내 말을 믿어주었지...$3",
	"14hearts.23": "내 남은 생애 동안, 이렇게 날 믿어주고, 받아들여주고, 사랑할 수 있는 사람을 만날 수 있을까?$3#$b#나는 네가 유일하다고 생각해.$4",
	"14hearts.24": "여기, 내가 만들어낸 묘목이야.[Custom_BlancheGoldenapple_Sapling]$0#$b#잘 키우면, 놀라지 마. 나중에 신화에 나오는 것 같은 황금 사과를 맺게 될거야.$1",
	"14hearts.25": "이 묘목은 내 분신처럼 만든 아이야. 먼 옛날, 과거의 나를 떠올리며 빚었어.$3#$b#....그리고 미래에는 분명 네게 힘이 되어줄거야.$1",
	"14hearts.26": "가장 아름다운 여신에게 사과를 바친 신화 속 인물처럼, 나도 내 삶에서 가장 아름다운 사람한테 주기 위해 만들었어.$3#$b#너에게 내가 이 나무를 선물한 기억이 그만큼 오래 기억되길 바라.$4#$b#나랑 결혼해줘서 고마워, @. 늘 사랑해.$4",
	"14hearts.27": "왜 그래, @?$0#$b#아, 원래 신화에서 황금 사과와 얽힌 전설은 비극이 아니었냐고?$6#$b#음, 파리스가 비극을 맞이한 이유는, 황금 사과를 선물할 여신을 잘못 고른 것 보다는 오이노네를 버려서 그런게 아니었을까 해.$2#$e#내 황금 사과 나무는 상대를 제대로 찾아갔으니까, 상관없지만.$1",
	
	
	//Villager's Dialogues
	
	"EvelynDialogues.1": "블랑슈는 가끔 우리집에 들러서 서재를 정리해주고 간단다.#$b#대출할 책을 집까지 가져와주기도 하지. 좋은 아이야.$h",
	"EvelynDialogues.2": "어서 오려무나, 마침 쿠키를 구웠단다. 하나 먹어보겠니? [223]$h#$e#엊그제는 블랑슈와 함께 쿠키를 구웠단다. 다음번에는 같이 굽자꾸나.",
	"EvelynDialogues.3": "블랑슈와는 잘 지내니, 아가?#$b#사서 아가는 참 착한 아이지만.. 가끔 또래보다는 어른들이랑만 어울리는 듯 해서 걱정이란다.#$e#부디 친구가 되어주려무나.$h",
	"EvelynDialogues.4": "블랑슈에게 안부 전해주겠니? 시간나면 와서 쿠키도 받아가라고 하렴.#$e#그 아이가 너와 결혼해서 기쁘단다.$h",
	"EvelynDialogues.5": "네가 블랑슈와 결혼해서 기쁘단다. 손녀 같은 아이였거든.#$e#행복할 자격이 있는 아이야... 착한 아이지.",
	"EvelynDialogues.6": "블랑슈는 네 농장을 마음에 들어할 것 같구나, 아가.$h#$e#워낙 화단 가꾸는 걸 좋아하던 아이였으니... 농장에서 사는게 행복하겠구나.",
	"CarolineDialogues.1": "우리 마을 도서관에서 사서로 일하는 블랑슈 알지? 같이 화단을 가꾸다 친해졌는데 괜찮은 아이라고 생각해.#$b#하지만 또래 애들이랑은 조금 겉도는 느낌이란다. 도시에서 와서 그런걸까?",
	"CarolineDialogues.2": "너와 블랑슈가 결혼한 건 기쁘지만.. 확실히 같이 티타임을 나눌 상대가 없어지니 조금 외롭네.#$e#아, 싫다는 뜻은 아니야. 그 아이가 행복해 보여서 기쁘니까.$h",
	"CarolineDialogues.3": "블랑슈와 지내는 생활은 좀 어떠니?#$b#네 농장에도 온실이 있으니까 그 아이가 좋아할거라 생각해.",
	"CarolineDialogues.4": "오, 혹시 오늘 도서관 들릴거니? 블랑슈에게 안부 전해줄래?#$e#시간 괜찮으면 우리 집에도 좀 들리라고 전해주렴.",
	"CarolineDialogues.5": "애비게일이랑 블랑슈는 서로 비슷한 또래니까 친하게 지내면 좋을텐데. 그렇게 생각하지 않니?#$e#서로 좋은 영향을 줄 것 같아. 어떻게 보면 둘의 성향은 정반대 같거든.$h",
	"GeorgeDialogues.1": "도서관에서 일하는 사서 아가씨는 가끔 우리집에 들리지. 알고있나?#$b#아내에게 손녀처럼 살갑게 굴더구만. 나쁘진 않지만 젊은 아가씨가 늙은이들하고만 있는게 썩 좋은 일만은 아니지.",
	"GeorgeDialogues.2": "엊그제는 사서 아가씨가 책장을 정리하고 갔어. 추가 수당도 안 받으면서 왜 그런 짓을 하지?#$e#그래도 착한 아가씨이긴 해. 이 나이가 되면 대가 없는 선행은 의심부터 하게 되니, 원.",
	"GeorgeDialogues.3": "사서 아가씨가 좋은 남편을 찾아서 다행이야. 착한 아가씨거든.^그래서, 아가씨는 사서 아가씨와 결혼했지? 사실 이해가 잘 안돼... 흐음. 그냥 내가 구식인 건지도...",
	"GeorgeDialogues.4": "그래서, 사서 아가씨와는 잘 지내나? 두 사람이 행복하기를 진심으로 바라네.^인정하지, 자네와 사서 아가씨와 결혼하고 난 후, 처음에는 이해를 잘 못했어... 여자 둘이 그렇게 지낸다는 게. 하지만 넌 너무나 훌륭한 사람이고, 둘이 진심으로 사랑한다는 것도 알겠어... 이제는 두 사람이 행복하길 바라.",
	
