{
  "Format": "2.9.0",
  "ConfigSchema": {
    "Enable Cellar": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "Toggles whether the mod is active or not.",
      "Section": "Mod Settings"
    },
    "Cellar Recolor": {
      "AllowValues": "Auto, Vanilla, VPR, Earthy, Starblue, Aster's Oak Saloon, RCTI Dark, RCTI Light",
      "Default": "Vanilla",
      "Description": "Changes custom tilesheet color to match your recolor mod. 'Auto' matches with CR Farmhouse. DO NOT set to Auto if CR Farmhouse is not installed.",
      "Section": "Visual Tweaks"
    },
    "Extra Room": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "Toggles the extra space in the cellar.",
      "Section": "Tweaks"
    }
  },

  "DynamicTokens": [
   // RECOLOR TOKENS
    {
      "Name": "CRCellarRecolor",
      "Value": "{{Spiderbuttons.CMCT/Config: crystalinerose.RusticFarmhouse, Recolor}}",
      "When": {
         "HasMod": "crystalinerose.RusticFarmhouse, Spiderbuttons.CMCT",
         "Cellar Recolor": "Auto"
      }
    },
    {
      "Name": "CRCellarRecolor",
      "Value": "{{Cellar Recolor}}",
      "When": {
         "Cellar Recolor |contains= Auto":  false
      }
    },
    {
      "Name": "CRCellarRecolor",
      "Value": "Vanilla",
      "When": {
         "HasMod |contains= crystalinerose.RusticFarmhouse": false,
         "Cellar Recolor |contains= Auto":  true
      }
    }
  ],

  "Changes": [
    // LOAD TILESHEETS
    {
      "Action": "Load",
      "Target": "Maps/CR_cellar",
      "FromFile": "assets/Tilesheets/{{CRCellarRecolor}}/{{TargetWithoutPath}}.png"
    },

    // LOAD MAP
    {
      "Action": "Load",
      "Target": "Maps/Cellar",
      "FromFile": "assets/CR_CellarRustic.tmx",
      "When": {
        "Enable Cellar": true
      },
      "Priority": "High +10"
    },

    // LOAD MAP - RCTI
    {
      "Action": "Load",
      "Target": "Maps/Cellar",
      "FromFile": "assets/CR_CellarRustic_RCTI.tmx",
      "When": {
        "Enable Cellar": true,
        "Cellar Recolor": "RCTI Dark, RCTI Light"
      },
      "Priority": "High +100"
    },

    // VISUAL PATCH TO DISABLE EXTRA ROOM
    // Remove Door
    {
      "Action": "EditMap",
      "Target": "Maps/Cellar",
      "FromFile": "assets/CR_CellarRustic_NoRoomPatch.tmx",
      "FromArea": { "X": "8", "Y": "10", "Width": "3", "Height": "3" },
      "ToArea": { "X": "8", "Y": "10", "Width": "3", "Height": "3" },
      "PatchMode": "Replace",
      "When": {
         "Enable Cellar": true,
         "Extra Room": false
      },
      "Priority": "Late +50"
    },
    // Hide extra room
    {
      "Action": "EditMap",
      "Target": "Maps/Cellar",
      "FromFile": "assets/CR_CellarRustic_NoRoomPatch.tmx",
      "FromArea": { "X": "0", "Y": "35", "Width": "28", "Height": "20" },
      "ToArea": { "X": "0", "Y": "35", "Width": "28", "Height": "20" },
      "PatchMode": "Replace",
      "When": {
         "Enable Cellar": true,
         "Extra Room": false
      },
      "Priority": "Late +50"
    },
    {
      "Action": "EditMap",
      "Target": "Maps/Cellar",
      "MapProperties": {
         "ScreenshotRegion": "0 0 27 23",
         "ViewportClamp": "0 0 28 24",
         "ViewportFollowPlayer": "T"
      },
      "When": {
         "Enable Cellar": true,
         "Extra Room": false
      }
    },
    
    // MMAP WARP HERE FOR EXTRA ROOM
    {
      "Action": "EditMap",
      "Target": "Maps/Cellar",
      "MapTiles": [
         // Warp from main cellar room to additional room
         {
            "Layer": "Buildings",
            "Position": {
               "X": 9,
               "Y": 12
            },
            "SetProperties": {
               "Action": "mushymato.MMAP_WrpHere 14 51 -1 true false doorOpen"
            }
         },
         // Warp from additional room back to main cellar
         {
            "Layer": "Back",
            "Position": {
               "X": 14,
               "Y": 53
            },
            "SetProperties": {
               "TouchAction": "mushymato.MMAP_WrpHere 9 13 -1 true false"
            }
         }
      ],
      "When": {
         "Enable Cellar": true,
         "Extra Room": true
      }
    }
  ]
}