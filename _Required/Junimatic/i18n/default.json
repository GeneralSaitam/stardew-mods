    "T4sugTti3v": "I like animals and the wonderful things you can make with their help...",

    // https://github.com/NermNermNerm/Junimatic/blob/084e61da6f77cd0feeab75b29c03d5b787e7999f/Junimatic/UnlockAnimal.cs#L232
    "Q2hxdvc5kS": "Hello @!  Are you missing any chickens?  I think one might have run off!",

    // https://github.com/NermNermNerm/Junimatic/blob/084e61da6f77cd0feeab75b29c03d5b787e7999f/Junimatic/UnlockAnimal.cs#L232
    "K9koWKoaPA": "I saw it across the river to the south of my farm!  I went over to try and round it up, but it ran away from me!$2#$b#Maybe it would come to you if you went down there and called it!",

    // https://github.com/NermNermNerm/Junimatic/blob/084e61da6f77cd0feeab75b29c03d5b787e7999f/Junimatic/UnlockAnimal.cs#L232
    "ES1Adkpzkl": "Oof! I need to be getting back! Anyway, I hope you can wrangle it back home!  Bye now!  Don't be a stranger!",

    // https://github.com/NermNermNerm/Junimatic/blob/084e61da6f77cd0feeab75b29c03d5b787e7999f/Junimatic/UnlockAnimal.cs#L255
    "liglB0huCJ": "Chicken Round-Up",

