    "xw8PvRWl5h": "@,^Please come visit me at my tent.  I've found something and I need your help to sort it out.^   -Linus",

    // https://github.com/NermNermNerm/Junimatic/blob/084e61da6f77cd0feeab75b29c03d5b787e7999f/Junimatic/UnlockFishing.cs#L368
