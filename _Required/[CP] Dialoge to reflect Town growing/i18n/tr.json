//Abigail
"snm.DRTG_Abigail_movieTheater": "Sinemaya gitmek için sabırsızlanıyorum, hepsi senin sayende tabii.",
"snm.DRTG_Abigail_Resort_Leaving": "Willy'e manzaralı yoldan geri dönebilir miyiz diye soracağım. Tekneyi çalışır hale getirmesine yardım ettiğin için teşekkürler.",
"snm.DRTG_Abigail_Resort_Umbrella_2": "Heyy @, benimle kumdan kale inşa etmek ister misin?#$e#Aslında, bi' kumdan zindan daha havalı olur! Hiç keşiflerinde zindan bulduğun oldu mu?$h",
"snm.DRTG_Abigail_Resort_Umbrella_3": "Ee.. @, bi' sal yapabilir misin? Tabii ki yaparsın, burayı baştan aşağı sen kurdun. Sal yapmak senin için çocuk oyuncağı olur. #$e#Buraya geliş yolunda uğramak isteyebileceğim bi' kaç havalı ada gördüm.",
"snm.DRTG_Abigail_Resort_Wander": "Hiç gömülü hazine buldun mu? Bu büyük bir ada ve bahse varım sen burayı komple keşfetmişsindir. #$e#Çabuk, bana bir kürek bul!#$e#Sakinsel kal, sadece latife ediyorum.$h",
//new line (working)
"snm.DRTG_Abigail_cc_Bridge": "Eski köprüyü tamir ettin ve ben eski taş ocağını keşfe çıktım! Baya eğlenceliydi! Teşekkür ederim, @!", 
//added with V4.5.0
"snm.DRTG_Abigail_cc_Minecart": "Kasabanın her yerindeki o maden arabalarını nasıl çalıştırdın?",
"snm.DRTG_Abigail_cc_Complete": "Acaba Halkevi hala hayaletli midir? Sence? Orada çok zaman geçirdiğini biliyorum.",
"snm.DRTG_Abigail_winter_28": "1 yılı devirdin he. burayı baya sevdin sen.",


//Alex
"snm.DRTG_Alex_cc_Bridge": "Geçen gece geç saatte koşu yapıyordum ve eski köprünün tamir edildiğini fark ettim. Orayı tamir ettirmeyi nasıl becerdin?",
"snm.DRTG_Alex_Resort_Entering": "Sonunda bur'dayız! Teknenin tamir edilip çalışmasına yardım ettiğin için teşekkürler.",
"snm.DRTG_Alex_Resort_Towel": "Ada olayını hallettiğin için sağ ol. Artık solgun olmanın hiçbir mazereti yok!",
"snm.DRTG_Alex_Resort_Towel_2": " Adamım, sonunda bu karın kaslarına biraz güneş ışığı vurması süper hissettiriyor.#$e#Evdeyken onları sürekli saklı tutunca biraz yazık oluyor.",
//added with V4.5.0
"snm.DRTG_Alex_movieTheater": "Sen filmler için para veriyo' musun? Yapımına yardım edenlerin indirim aldığını duydum.",
"snm.DRTG_Alex_cc_Complete": "Sanırım artık baya ünlü oldun.",
"snm.DRTG_Alex_winter_28": "Bu sene benim yılım olucak. #$e# He... Senin de iyi yılın olur umarım.",


//Caroline
"snm.DRTG_Caroline_Tue": "Toplayıcılık yapmayı çok seviyorum. Ne bulacağını asla bilemiyorsun. Sen ne buldun?",
"snm.DRTG_Caroline_summer_Tue": "Yazın çok güzel çiçekler oluyor.",
"snm.DRTG_Caroline_fall_Tue": "Ormanda yenebilir mantarlar gördüm.#$e#Toplayıcılık para kazanmak için eğlenceli bir yol olabiliyor. Ya da bulduklarını birilerine hediye olarak ya da yiyecek olarak kullanabilirsin.",
"snm.DRTG_Caroline_winter_Tue": "Bu mevsimde her zaman çok fazla çobanpüskülü bulunur, ama ben onlarla ne yapacağımı hiç bilmiyorum. Herhangi bir fikrin var mı?",
"snm.DRTG_Caroline_Resort_Leaving": "Burayı tamir ettiğin için teşekkürler. Bugün çok güzeldi. Buu akşam iyi uyurum!$h",
"snm.DRTG_Caroline_Resort_Shore": "Buranın suyu Vadi'deki suya göre çok daha ılık. Gerçekten çok hoş! Ada'yı bu hale getirmene hayran kaldım.",
"snm.DRTG_Caroline_Resort": "Selam, @. Buraya rahatlamaya mı yoksa çalışmaya mı geldin? Çoktan adada bir sürü iş yaptın. Biraz rahatlamalısın.",		
//new lines (working)
"snm.DRTG_Caroline_cc_Complete": "Halkevi tekrardan iyi gözüküyor. Burayı tamir ettiğin için teşekkürler.",
"snm.DRTG_Caroline_movieTheater": "Nasıl bu kadar hızlı sinema inşa ettirdin? Bu inanılmaz.",
//added with V4.5.0
"snm.DRTG_Caroline_cc_Bridge": "Eski köprü tamir oldu. Sağ ol. Pierre'le oralara yürüyüş yaparıdık... Ne güzel anılar.",


//Clint
"snm.DRTG_Clint_Tue": "Şu sıralar çok fazla alet geliştirmeleri yapıyorum. Geliştirmem için kendininkileri getirmeyi unutma.",
"snm.DRTG_Clint_Wed": "Maceracılar için kazmalarını geliştirmekle meşgulüm. Sana nasıl yardım edebilirim?",
"snm.DRTG_Clint_Thu": "Bir başka yoğun gün.",
"snm.DRTG_Clint_Sat": "Bu kasabaya neden ve nasıl geldiğimi merak ederdim. Artık etmiyorum, Olmak için iyi bir yer seçmişim. Sen buraya geldiğinden beri bir sürü işim var.",
"snm.DRTG_Clint_Sun": "Bir araya ihtiyacım var.",
"snm.DRTG_Clint_Resort_Entering": "Burası harika! Düzelttiğin için teşekkürler. Özel kırmızı şortumu giyeceğim. Çok dikkat çekici olması gerekiyor.",
"snm.DRTG_Clint_Resort_Leaving": "Bugün iyiydi. Burayı düzeltmek için harcadığın emekler sağolsun.",
"snm.DRTG_Clint_Resort_Bar": "Acıktım, hadi Gus bugün için ne lezzetler hazırlamış bakalım. Ne de güzel mekan.",
"snm.DRTG_Clint_Resort": "Süper bir gün, senin sıkı çalışman sağolsun.",
"snm.DRTG_Clint_cc_Minecart": "Kasabanın eski vagon sistemi tekrar çalışmaya başladı. Teşekkür ederim. Madenlere gidip gelmek için çok elverişli.",
//new lines (Working)
"snm.DRTG_Clint_cc_Bridge": "Eski köprüyü tamir ettirmişsin! Teşekkürler, @.", 
//added with V4.5.0
"snm.DRTG_Clint_movieTheater": "Herhangi biri benimle film izlemeye gider mi acep...", 
"snm.DRTG_Clint_cc_Complete": "Kazan dairesi... Benim için daha fazla iş anlamına geliyor. *iç çekiş* #$e# He orayı düzelttiğin için teşekkürler.", 

		
//Demetrius
"snm.DRTG_Demetrius_summer_Fri": "$p 40#Maru'nun seni arka taraftaki teleskopa baktırdığını duydum. Gece gökyüzünde bu kadar çok şey görmek gerçekten inanılmaz.",
"snm.DRTG_Demetrius_Resort_Leaving": "Bu verileri aylarca analiz edeceğim. Bu ada için gerçekten çok emek verdin.",
"snm.DRTG_Demetrius_Resort_Chair": "Eğleniyor musun, @? Burayı toparladın, artık biraz keyfini çıkarma zamanı.",
"snm.DRTG_Demetrius_Resort": "Bulduğun yer harika. Egzotik yaşam kaynıyor resmen!",
"snm.DRTG_Demetrius_Sun": "Arada bir işten uzaklaşıp mola vermek iyi geliyor.#$e#Gerçi bu kasaba için yaptığın onca şey varken pek kolay sayılmaz.",
"snm.DRTG_Demetrius_winter_Tue": "Yapılması gereken bir iş olursa eşimle konuşabilirsin.",
"snm.DRTG_Demetrius_winter_Wed": "Yemek yapmak biraz laboratuvar çalışması gibidir.",
//new lines (Working)
"snm.DRTG_Demetrius_cc_Bridge": "Eski köprüyü onardığını duydum. Taş ocağında ne tür bitkiler ve hayvanlar olduğunu keşfetmeyi dört gözle bekliyorum.",
//added with V4.5.0
"snm.DRTG_Demetrius_cc_Complete": "Halkevi'ni nasıl tekrardan kurdun?",

//Elliot
"snm.DRTG_Elliot_Resort_Entering": "Ne yolculuktu ama! Willy'nin teknesini tamir etmesine yardım ederken harika iş çıkardın.",
"snm.DRTG_Elliot_Resort_Wander": "Geceleri buralara yakın kıyıya korsanların geldiğine dair söylentiler duydum. Oldukça çılgın olabiliyormuş! Adayı gezerken sen hiç rastladın mı?",
"snm.DRTG_Elliot_Resort": "İtiraf etmeliyim, bu sahil benim mütevazı kumsalımı bile gölgede bırakıyor. Tatil köyünü onardığın için teşekkürler.",
"snm.DRTG_Elliot_Wed": "Orman harika bir yerdir. Eminim sen de defalarca yolun düşmüştür.",
"snm.DRTG_Elliot_fall_Tue": "Bir zamanlar yağmalanmış altınlarla dolu bir korsan gemisinin burada battığı söylenir. Acaba yolculuklarında böyle bir şeye denk geldin mi?",
//added with V4.5.0
"snm.DRTG_Elliot_cc_Bridge": "Tekrar hayata döndürülmüş eski bir köprü... Gidip bunun hakkında bir şeyler yazmalıyım.",
"snm.DRTG_Elliot_cc_Complete": "Halkevi artık hayat dolu, harikulade.",
"snm.DRTG_Elliot_movieTheater": "Kitaplar her zaman daha iyi olsa da iyi bir film izlemeyi bende severim.",
				

//Emily
"snm.DRTG_Emily_reject_866": "Oh, bu çok güzel... Bahse varım Sandy buna bayılırdı.", //added with V3.0.0
"snm.DRTG_Emily_Resort_Entering": "Hm, burayı sevdim! Papağanlarla dolu! Burayı nasıl buldun ki?",
"snm.DRTG_Emily_Resort_Leaving": "Ah... ciğerlerim mükemmel hissediyor. Bütün yaptıkların için teşekkür ederim.", 
"snm.DRTG_Emily_Resort_Bar": "Bu mekanı düzelttin ve bu kez ben barın bu tarafında olabiliyorum. İyi hissettiriyor.$h",
"snm.DRTG_Emily_fall_Wed": "Çöle gidersen Sandy'e selam vermeyi unutma.",
"snm.DRTG_Emily_fall_Thu": "Clint iyi biri ama çok utangaç. Onun arkadaşı olduğun için mutluyum.",
//new line (Working)
"snm.DRTG_Emily_cc_Bus": "Otobüsün tekrar çalışmasını sağladığın için çok mutluyum. Sandy'i tekrar görebilirim!",
//added with V4.5.0
"snm.DRTG_Emily_Mon": "Her zaman birbirimizle uyuşmasak da Haley iyi bir kardeş.",
"snm.DRTG_Emily_Tue8": "Biliyor musun, @... Bence gelecek ikimiz için de aydınlık görünüyor, ya da dur, bu kasaba için, gerçekten çok fazla düzelttin burayı.",
"snm.DRTG_Emily_Sun4": "Bu ev annemlerden bize emanet kaldı. Yıllardır dünyayı geziyorlar.#$e#Ne zaman dönecekleriyle ilgili hiçbir fikrimiz yok.#$e#Gerçi burada yaşamayı seviyorum. Memleket güzel ve kasaba çok hoş.",


//Evelyn (working)
"snm.DRTG_Evelyn_Tue": "George'a aldırma, tatlım. O bazen huysuz olabiliyor.#$e#Pırasan var mı? Pırasayı çok sever!",
//added with V4.5.0
"snm.DRTG_Evelyn_winter_28": "Güzel bir yıl oldu. Burada olduğum için minnettarım.",
"snm.DRTG_Evelyn_winter_Sat8": "@, sana George'la bu evde 30 yılı aşkın süredir yaşadığımızı söylemiş miydim?#$e#Umarım sende burada uzunca bir süre kalırsın.$h",


//George (working)
"snm.DRTG_George_Mon": "Çok konuşan birisi değilim.",
"snm.DRTG_George_Wed": "Alex isteyebileceğim en iyi torun.",
"snm.DRTG_George_Fri": "Çiftliğin ne durumda?",		
//new lines (working)
"snm.DRTG_George_movieTheater": "Bize bi sinema mı yaptırdın? Evelyn'i bir randevuya çıkaracağım!",
//added with V4.5.0
"snm.DRTG_George_winter_28": "Bir yıl daha uçtu, buralarda olduğun için sağol.",
"snm.DRTG_George_winter_Sat8": "@, bu eski evin hep bi işi oluyor. Biraz büyü yapıp lavaboyu tamir eder misin? ",


//Gus
"snm.DRTG_Gus_Resort_Entering": "Merhaba, @! Burada olduğun için mutluyum. Bu mekanı düzelterek müthiş bir iş yaptın.",
"snm.DRTG_Gus_Resort_Leaving": "Hey, bütün sıkı çalışman için tekrar teşekkürler. Seninle Vadi'de görüşürüz, @.",
"snm.DRTG_Gus_Resort": "Stardrop Saloon'u yeniden dekore etmeye ne dersin? Yani, bu yerin ne kadar güzel olduğuna bir bak.",
"snm.DRTG_Gus_Thu": "Pam ve Clint neredeyse her akşam salona geliyor. Onlarsız işim bitecek diye endişelenirdim, ama sen taşındığından beri daha fazla turist geliyor ve çok para harcıyorlar.",
"snm.DRTG_Gus_Sat": "Aşçılıkla aran iyi mi? Bu kasaba için yaptığın işlerden ara verdiğinde tariflerimizi birbirimizle paylaşmalıyız.",
"snm.DRTG_Gus_Sun": "Sen buraya geldiğinden beri işler daha da iyiye gidiyor. Baya popülersin!",
//New line (working)
"snm.DRTG_Gus_cc_Complete": "Halkevi'nde yemek pişirmeyi sabırsızlıkla bekliyorum. Düzelttiğin için teşekkürler.",
//added with V4.5.0
"snm.DRTG_Gus_winter_28": "Verimli bir yıl geçirdiğin için tebrik ederim.",

//Haley
"snm.DRTG_Haley_Resort_Entering": "Giderken bir yunus gördüm! Bunun gerçekleşmesine yardım ettiğine neredeyse inanamıyorum.",
"snm.DRTG_Haley_Resort_Shore": "Hayatın seni sürükleyebileceği yerler... Çok garip. Kim bilir başka nasıl yerler vardır? Hey, bana keşfettiğin yerlerden bahsetsene.",
"snm.DRTG_Haley_Resort_Towel_2": "Tropikal bir kumsalda uzanmak.#$b#*iç çeker* Galiba sonunda evrendeki yerimi buldum.#$e#Ama sanırım Yıldızçiyi Vadisi de çok kötü bir yer değil, özellikle burada tatil yapabileceksem!",
"snm.DRTG_Haley_Resort_Bar": "Gus sadece benim için tatlış, meyveli bir içecek hazırladı!$h Resort barını tamir ettiğin için mutluyum.",
"snm.DRTG_Haley_Resort": "Burası mükemmel bir plaj. Mümkün olsa sonsuza kadar burada kalırdım! Düzelttiğin ada evinde kalabilmeyi çok isterdim, ama Emily'yi ve arkadaşlarımı özlerdim.",
"snm.DRTG_Haley_summer_Tue": "Yine üstün başın kirli, ha? Hep çalışıyor gibisin.",
"snm.DRTG_Haley_winter_Tue2": "Selam @",
"snm.DRTG_Haley_winter_Sun6": "Bugün meşgulüm.",
//New line (Working)
"snm.DRTG_Haley_cc_Bus": "Otobüsü tekrar çalışır hale getirdiğine göre alışverişe çıkma zamanı gelmiş demektir!",
//Added with 4.5.0
"snm.DRTG_Haley_cc_Complete": "Beni şaşırtıyorsun.",


//Harvey
"snm.DRTG_Harvey_Mon10": "Seni görmek her zaman güzel. ", //added with V3.0.0
"snm.DRTG_Harvey_Sun": "Şu aralar hastalarımla çevrimiçi görüşmeler yapıyorum. Bu, faturalarımı ödememe yardımcı oluyor ve doktora gidemeyen insanlara da yardım ediyor.",
"snm.DRTG_Harvey_summer_Fri": "İnsanlar yazın çok hasta olmuyor, ki bu iyi bir şey. Çevrimiçi veya yüz yüze görüştüğüm hastalarla daha fazla zaman geçirebiliyorum.",
"snm.DRTG_Harvey_winter_Sun": "Grip mevsimi her zaman yoğundur. Son zamanlarda çok sayıda yeni hasta geldi.",
"snm.DRTG_Harvey_Resort_Shore": "Tüm sahili cam parçaları bulmak için taradım. Kimsenin ayağının kesilmesini istemeyiz! Fazla bir şey bulamadım gerçi - burayı kurup işletmeye başladığında harika bir iş çıkarmışsın.",
"snm.DRTG_Harvey_Resort_Chair": "Ara sıra dinlenmek için fırsat bulmak güzel. Burayı düzelttiğin için teşekkürler. #$b#Asıl sorun, endişelerini bir kenara bırakabilmektir...$s",
"snm.DRTG_Harvey_Resort": "Sadece tatil köyünü kurup işletmeye başladığın için... Sana küçük bir sır vereceğim... Ben sadece kolluklarla yüzebiliyorum.$s",
//New line (Working)
"snm.DRTG_Harvey_cc_Bus": "Otobüsü tekrar çalışır hale getirmen iyi oldu. Artık Pelikan Kasabası dışındaki hastaları ziyaret edebilirim.",
//Added with 4.5.0
"snm.DRTG_Harvey_cc_Complete": "Halkevi'ni düzelterek müthiş bir iş yaptın. Halk içinde aktif bir karaktere sahip olmak sağlığın için çok faydalı.",


//Jas
"snm.DRTG_Jas_Thu2": "Bayan Penny bana el yazısıyla okumayı ve adımı imzalamayı öğretiyor.",
"snm.DRTG_Jas_Resort_Entering": "Bir yengeç gördüm! Sen hangi hayvanları gördün?",
"snm.DRTG_Jas_Resort_Leaving": "Ayakkabılarım kuma dolsa da bugün çok eğlendim.#$e#Marnie teyzem bu tatil için teşekkür etmem gerektiğini söyledi. Yani - şey... teşekkür ederim!",
"snm.DRTG_Jas_Thu": "Merhaba.",
"snm.DRTG_Jas_Fri": "Selam.",
"snm.DRTG_Jas_Sun": "Şey... b...bir şey mi istiyorsun?$u#$e#",
"snm.DRTG_Jas_Sat2": "Bazen nehirde kerevit ararım.",
//Added with 4.5.0
"snm.DRTG_Jas_cc_Complete": "Halkevi artık yeni ve güzel, teşekkür ederiz!",


//Jodi
"snm.DRTG_Jodi_cc_Bus": "Otobüsü tekrar çalışır hale getirdin. Pam buna çok sevinmiştir...#$b#İşini kaybettikten sonra daha çok içtiğini duymuştum... Umarım bu ona iyi gelir.",
"snm.DRTG_Jodi_Resort_Entering": "Burayı sen mi toparladın?! Vay canına, ne güzel bir sürpriz! Teşekkür ederim.",
"snm.DRTG_Jodi_Resort": "Manzara nefes kesici! Göz alabildiğine masmavi...",
"snm.DRTG_Jodi_Resort_Bar": "Sen ve Gus geldiğinizde hepimiz mutlu oluyoruz. Barı sen yaptın, içkileri de o hazırlıyor.",
//Added with 4.5.0
"snm.DRTG_Jodi_cc_Complete": "Halkevi'ni düzelttiğin için seninle gurur duyuyorum.",
"snm.DRTG_Jodi_movieTheater": "Kent ve ben filmlere gider dururduk. Başbaşa. Düşündükçe duygulanıyorum.",


//Kent
"snm.DRTG_Kent_Resort_Leaving": "Artık eve dönme vakti. Burayı düzelttiğin için sağ ol.",
"snm.DRTG_Kent_Resort": "Tekne yolculuğu çok keyifliydi. Hatta yön bulmada biraz denizcilik eğitimimi bile kullandım. Willy, tekneyi onarmaya yardım ettiğini söyledi. Teşekkürler.",
"snm.DRTG_Kent_Tue": "Bazen ben yokken hiçbir şey değişmemiş gibi geliyor. Sen ve çiftliğin hariç tabii.",
"snm.DRTG_Kent_Tue2": "Bu kasaba için çok şey yaptın. Değişime alışmak zor oluyor.",
"snm.DRTG_Kent_Thu": "Ben yokken Sam ve Vincent bayağı büyümüşler.",
//new lines (working)
"snm.DRTG_Kent_cc_Complete": "Halkevi'ni onardın. Bu bayağı zahmetli bir iş olmalı.",
//added V4.5.0
"snm.DRTG_Kent_movieTheater": "Şu kasaba için Lewis'ten çok iş yaptın.",
"snm.DRTG_Kent_married": "Bir yastıkta kocayın, @. Umarım evliliğiniz kutlu olur. Sadece her ekin gibi, bunun da emek istediğini unutma.",


//Leah
"snm.DRTG_Leah_summer_Fri": "Akçaağaç şurubuna bayılıyorum.",
"snm.DRTG_Leah_Resort_Entering": "Kimseye söyleme ama Willy birkaç dakika tekneyi kullanmama izin verdi. Onarımı için tüm malzemeleri senin sağladığını söyledi. Bu çok ince bir davranış.",
"snm.DRTG_Leah_Resort_Leaving": "Gerçekten çok dinlendiriciydi. Burayı onardığın için teşekkürler.",
//new lines (working)
"snm.DRTG_Leah_cc_Complete": "Halkevi'ni onardığına göre, el işi odasını sık sık kullanacağım.",
"snm.DRTG_Leah_cc_Bus": "Otobüsü onarmana sevindim. Çöle gidip resim yapacağım.",
