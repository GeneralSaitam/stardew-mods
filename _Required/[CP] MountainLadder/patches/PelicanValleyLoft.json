// Compatibility with: https://www.nexusmods.com/stardewvalley/mods/30295

{
  "Changes": [
    {
      "LogName": "[PelicanValleyLoft] Adding ladder at `Maps/Mountain`",
      "Action": "EditMap",
      "Target": "Maps/Mountain",
      "FromFile": "assets/MountainLadder.tmx",
      "FromArea": {
        "X": 0,
        "Y": 0,
        "Width": 1,
        "Height": 4
      },
      "ToArea": {
        "X": 24,
        "Y": 25,
        "Width": 1,
        "Height": 4
      },
      "When": {
        "query: {{HasFlag |contains=communityUpgradeShortcuts}} AND {{OnlyWithShortcutsUpgrade}} OR NOT {{OnlyWithShortcutsUpgrade}}": true,
        "HasMod |contains=FireRedLily.NPCApartments": true
      }
    }
  ]
}
