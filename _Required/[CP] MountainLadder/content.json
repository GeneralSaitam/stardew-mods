{
  "Format": "2.9.0",
  "ConfigSchema": {
    "OnlyWithShortcutsUpgrade": {
      "AllowValues": "true, false",
      "Default": "true"
    }
  },
  "Changes": [
    {
      "LogName": "Loading ladder assets",
      "Action": "Load",
      "Target": "assets/spring_ladder.png, assets/summer_ladder.png, assets/fall_ladder.png, assets/winter_ladder.png",
      "FromFile": "assets/{{TargetWithoutPath}}"
    },
    {
      "LogName": "Patching for \"PelicanValleyLoft\" mod",
      "Action": "Include",
      "FromFile": "patches/PelicanValleyLoft.json"
    },
    {
      "LogName": "Adding ladder at `Maps/Mountain`",
      "Action": "EditMap",
      "Target": "Maps/Mountain",
      "FromFile": "assets/MountainLadder.tmx",
      "FromArea": {
        "X": 0,
        "Y": 0,
        "Width": 1,
        "Height": 4
      },
      "ToArea": {
        "X": 25,
        "Y": 25,
        "Width": 1,
        "Height": 4
      },
      "When": {
        "query: {{HasFlag |contains=communityUpgradeShortcuts}} AND {{OnlyWithShortcutsUpgrade}} OR NOT {{OnlyWithShortcutsUpgrade}}": true,
        "HasMod |contains=FireRedLily.NPCApartments": false
      }
    }
  ]
}
