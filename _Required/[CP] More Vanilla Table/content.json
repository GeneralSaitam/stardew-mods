{
"Format": "2.0.0",

	"ConfigSchema": 
	{
		"Desert Furniture": 
		{
			"Description": "Choose whether the Desert Furniture is in the Catalogue or the Festival Vendor",
			"AllowValues": "Festival Vendor, Catalogue",
			"Default": "Festival Vendor"
		},
		"Add Wooden Coffee Table":
		{
			"AllowValues": "true, false",
			"Default": "true",
			"Section": "Add Coffee Table that have the same texture as regular table"
		}
	},
	"Changes": 
	[
	
        {
			"Action": "Load",
			"Target": "Mods/{{ModId}}/widetable, Mods/{{ModId}}/coffeetable, Mods/{{ModId}}/normaltable",
            "FromFile": "assets/{{TargetWithoutPath}}.png" 
        },
		{
			"LogName": "Wide Table",
			"Action": "Include",
			"FromFile": "data/widetable.json"
		},
		{
			"LogName": "Coffee Table",
			"Action": "Include",
			"FromFile": "data/coffeetable.json"
		},
		{
			"LogName": "Normal Table",
			"Action": "Include",
			"FromFile": "data/normaltable.json"
		},
		{
			"When": {"Add Wooden Coffee Table": true},
			"Action": "Include",
			"FromFile": "data/coffeetable2.json"
		},
		{
			"When": {"Desert Furniture": "Festival Vendor"},
			"Action": "Include",
			"FromFile": "data/desert_f_vendor.json"
		},
		{
			"When": {"Desert Furniture": "Catalogue"},
			"Action": "Include",
			"FromFile": "data/desert_f_catalogue.json"
		}
	]
}