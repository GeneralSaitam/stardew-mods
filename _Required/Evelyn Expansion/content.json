{
    "Format": "2.8.0",
    "ConfigSchema": {
        "Evelyn Dialogue": {
            "AllowValues": "Enabled, Disabled",
            "Default": "Enabled",
            "Section": "NPC Dialogue",
            "Description": "Enable or disable custom dialogue for Evelyn."
        },
        "George Dialogue": {
            "AllowValues": "Enabled, Disabled",
            "Default": "Enabled",
            "Section": "NPC Dialogue",
            "Description": "Enable or disable custom dialogue for George."
        },
        "Evelyn Events": {
            "AllowValues": "Enabled, Disabled",
            "Default": "Enabled",
            "Section": "NPC Cutscenes",
            "Description": "Enable or disable custom cutscenes and events for Evelyn."
        },
        "George Events": {
            "AllowValues": "Enabled, Disabled",
            "Default": "Enabled",
            "Section": "NPC Cutscenes",
            "Description": "Enable or disable custom cutscenes and events for George."
        }
    },
    "Changes": [
        {
            "Action": "Include",
            "FromFile": "code/Events/mail.json, code/Events/quests.json, code/Events/triggers.json, code/Events/events.json, code/Compat/Migration/migrate.json",
            "When": {
                "HasMod |contains=LucyTheDove.PTE": false
            }
        },
        {
            "Action": "Include",
            "FromFile": "code/NPCs/Evelyn/dialogue.json",
            "When": {
                "HasMod |contains=LucyTheDove.PTE": false,
                "Evelyn Dialogue": "Enabled"
            }
        },
        {
            "Action": "Include",
            "FromFile": "code/NPCs/George/dialogue.json",
            "When": {
                "HasMod |contains=LucyTheDove.PTE": false,
                "George Dialogue": "Enabled"
            }
        }
    ]
}