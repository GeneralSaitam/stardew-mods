	},
	// Great Luck Fixing Random to ~20% 2/10 w/luck key to keep luck chances seperated
	{
		"Name": "Roosters_20EggPerc",
		"Value": "{{Random: true,true,false,false,false,false,false,false,false,false |key=luck4}}"
	},
	//Egg Hatching % Effected by Daily Luck, Awful = 0% - Bad = 5% - Neutral = 10% - Good = 15% - Great = 20%
	//Awful
	{
		"Name": "FinEggPerc",
		"Value": "false",
		"When": {
			"Query: {{DailyLuck}} < -0.07": true
		}
	},
	//Bad
	{
		"Name": "FinEggPerc",
		"Value": "{{Roosters_5EggPerc}}",
		"When": {
			"Query: {{DailyLuck}} >= -0.07 AND {{DailyLuck}} < -0.02": true
		}
	},
	//Neutral
	{
		"Name": "FinEggPerc",
		"Value": "{{Roosters_10EggPerc}}",
		"When": {
			"Query:{{DailyLuck}} >= -0.02 AND {{DailyLuck}} <= 0.02": true
		}
	},
	//Good
	{
		"Name": "FinEggPerc",
		"Value": "{{Roosters_15EggPerc}}",
		"When":{
			"Query: {{DailyLuck}} > 0.02 AND {{DailyLuck}} <= 0.07": true
		}
	},
	//Great
	{
		"Name": "FinEggPerc",
		"Value": "{{Roosters_20EggPerc}}",
		"When": {
			"Query: {{DailyLuck}} > 0.07": true
		}
	}
],
