{
    "Changes": [
    //Rasmodia
    {
        "Action": "EditImage",
        "Target": "Mods/Wolf.RomRas/Rasmodius_Portrait",
        "FromFile": "Assets/RomRas/{{PortraitRecolor}}/Witch{{WizardVariation}}",
        "PatchMode": "Replace",
        "When": {
          "HasMod|contains=Nom0ri.RomRas": false,
        },
    },
  
    //Rasmodius
    {
        "Action": "EditImage",
        "Target": "Mods/Wolf.RomRas/Rasmodius_Portrait",
        "FromFile": "Assets/SVE/{{PortraitRecolor}}/Wizard{{WizardVariation}}",
        "PatchMode": "Replace",
        "When": {
          "HasMod|contains=Nom0ri.RomRas": true,
        },
    },

    //Frame
    {
        "Action": "EditImage",
        "Target": "Mods/Wolf.RomRas/Rasmodius_Portrait",
        "FromFile": "Assets/Frame/{{PortraitRecolor}}/{{Frame}}.png",
        "ToArea": { "X": "0", "Y": "0", "Width": 32, "Height": 32},
        "When": {
            "IsFrameSeasonal": "No",
            "Query:'{{Frame}}' = 'Unique'": false,
        },
        "PatchMode": "Overlay", 
    },

    {
        "Action": "EditImage",
        "Target": "Mods/Wolf.RomRas/Rasmodius_Portrait",
        "FromFile": "Assets/Frame/{{PortraitRecolor}}/{{IsFrameSeasonal}}/{{Season}}.png",
        "ToArea": { "X": "0", "Y": "0", "Width": 32, "Height": 32},
        "When": {
            "IsFrameSeasonal": "{{Frame}}",
            "Season": "{{Season}}",
        },
        "PatchMode": "Overlay",
    },
    ]
}