{
    "Format": "2.4.0",
	
//	CONFIG

    "ConfigSchema": {
		"World_Map_Recolor": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Change the color of the farm area on the world map if you're using a recolor. May not work alongside SVE if the recolor mod itself doesn't support SVE.",
			"Section": "Map"
		},
		"World_Map_AToMS": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will ignore the mod automatic detection of your recolors and will instead allow you to select it manually in AToMS. It is not required to also activate the manual override in AToMS, selecting a recolor is enough.",
			"Section": "Map"
		},
		"World_Map_SVE": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Always force the usage of SVE compatible maps if any is available, whether you're using the automatic detection or the manual override. Will work even if Stardew Valley Expanded is not installed.",
			"Section": "Map"
		},
//
		"Use_Northern_Path_WaFF": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Add a new map between WaFF's northern exit and the Backwoods.",
			"Section": "Additional_Locations"
		},
		"Use_Northern_Path_WaFFLE": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Add a new map between WaFFLE's northern exit and the Backwoods.",
			"Section": "Additional_Locations"
		},
//
		"Abandoned_Shed_Appearance": {
			"AllowValues": "Auto, Default, Gwen",
			"Default": "Auto",
			"Description": "Either let the game decide or manually select the outside appearance of the shed to fit different textures packs.",
			"Section": "Abandoned_Shed_Ex"
		},
		"Use_Shed_WaFF": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Make the abandoned shed available and upgradable when playing on WaFF. Entering it as well as the available floors will depend on your farm advancement.",
			"Section": "Abandoned_Shed_Ex"
		},	
		"Unlock_Shed_WaFF": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Unlock and fully upgrade the abandoned shed on WaFF, no matter the advancement of your farmhouse (casks still need the cellar in order to work). Useful if any issue prevents the upgrades from unlocking the normal way.",
			"Section": "Abandoned_Shed_Ex"
        },
		"Abandoned_Shed_Location_WaFF": {
			"AllowValues": "Northern_Path, Farm_Pen, Farm_TFall",
			"Default": "Northern_Path",
			"Description": "Set the abandoned shed location on WaFF.",
			"Section": "Abandoned_Shed_Ex"
		},
		"Use_Shed_WaFFLE": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Make the abandoned shed available and upgradable when playing on WaFFLE. Opening it as well as the available floors will depend on your farm advancement.",
			"Section": "Abandoned_Shed_Ex"
		},	
		"Unlock_Shed_WaFFLE": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Unlock and fully upgrade the abandoned shed on WaFFLE, no matter the advancement of your farmhouse (casks still need the cellar in order to work). Useful if any issue prevents the upgrades from unlocking the normal way.",
			"Section": "Abandoned_Shed_Ex"
        },
		"Abandoned_Shed_Location_WaFFLE": {
			"AllowValues": "Northern_Path, Farm_Pen, Farm_TFall",
			"Default": "Northern_Path",
			"Description": "Set the abandoned shed location when playing on WaFFLE.",
			"Section": "Abandoned_Shed_Ex"
		},
//
		"Shed_Planks": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Add planks adjacent to the shed's walls and pillars.",
			"Section": "Abandoned_Shed_Entrance"
        },
		"Shed_Planks_Type": {
			"AllowValues": "Mixed, Light, Dark, Stone",
			"Default": "Mixed",
			"Description": "Select the color of the floor planks adjacent to the shed's walls and pillars, or change them to stone.",
			"Section": "Abandoned_Shed_Entrance"
        },
		"Shed_Planks_Textures": {
			"AllowValues": "Default, Medieval",
			"Default": "Default",
			"Description": "Select the texture design of the floor planks/stones adjacent to the shed's walls and pillars.",
			"Section": "Abandoned_Shed_Entrance"
        },
		"Shed_Pillars_WaFF": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Decorate the shed's main room with support pillars. Only apply when playing on WaFF.",
			"Section": "Abandoned_Shed_Entrance"
        },
		"Shed_Pillars_WaFFLE": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Decorate the shed's main room with support pillars. Only apply when playing on WaFFLE.",
			"Section": "Abandoned_Shed_Entrance"
        },
//
		"Cellar_Allows_Casks_in_Shed_F0": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Once available, extend the usage of casks to the entry floor of the abandoned shed instead of limiting it to the shed basement.",
			"Section": "Abandoned_Shed_Floors"
        },	
		"Roof_Greenhouse_Type_WaFF": {
			"AllowValues": "Fields_Trees, Fields, Trees",
			"Default": "Fields_Trees",
			"Description": "When playing on WaFF, set the roof greenhouse to accommodate either 8 iridium sprinklers and 20 trees, 12 sprinklers and 4 trees, or 2 sprinklers and 40 trees.",
			"Section": "Abandoned_Shed_Floors"
		},
		"Roof_Greenhouse_Type_WaFFLE": {
			"AllowValues": "Fields_Trees, Fields, Trees",
			"Default": "Fields_Trees",
			"Description": "When playing on WaFFLE, set the roof greenhouse to accommodate either 8 iridium sprinklers and 20 trees, 12 sprinklers and 4 trees, or 2 sprinklers and 40 trees.",
			"Section": "Abandoned_Shed_Floors"
		}
	},

