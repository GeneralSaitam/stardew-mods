{
  // ---- GMCM config labels/tooltips (shown on hover in Generic Mod Config Menu) ----
  "config.MapleSprites.name": "Maple's Appearance",
  "config.MapleSprites.description": "Choose which of Maple's two sprite designs she uses. Takes effect on the next day or after a game restart.",
