  ],
  "When": {
    "EnableBasement": true
  }
},

    {
  "LogName": "Add Basement To Saloon Return Warp",
  "Action": "EditMap",
  "Target": "Maps/Custom_SaloonBasement",
  "TextOperations": [
    {
      "Operation": "Append",
      "Target": [ "MapProperties", "Warp" ],
