"Sophia.8hearts.15": "!!!$9",
"Sophia.8hearts.16": "So yummy!$9",
"Sophia.8hearts.17": "Dusty?$1", //I don't like the word doggo sorry 
"Sophia.8hearts.18": "!!!$1",
"Sophia.8hearts.19": "Want some pets?$9",
"Sophia.8hearts.20": "!!!$4",
