{
	"Format": "2.9.0",
	"ConfigSchema": {
		//Farm
		"ShippingBin Style": {
			"AllowValues": "Wood01, Wood02, Metal01, Metal02, Stone01, Stone02",
			"Default": "Wood01",
			"Section": "Farm"
		},
		"Wood": {
			"AllowValues": "Bamboo, Birch, Black, Cursed, Classic, Mahogany, Oak, Pine, SeaWood, Swamp, Walnut, White",
			"Default": "Oak",
			"Description": "Only for the Wood Style01 and Style02",
			"Section": "Farm"
		},
		"Metal & Stone": {
			"AllowValues": "Classic, NonClassic, Light, Medium, Dark",
			"Default": "Medium",
			"Section": "Farm"
		},
		//Island Farm
		"Island ShippingBin Style": {
			"AllowValues": "Wood01, Wood02, Metal01, Metal02, Stone01, Stone02",
			"Default": "Wood01",
			"Section": "Island Farm"
		},
		"Island Wood": {
			"AllowValues": "Bamboo, Birch, Black, Cursed, Classic, Mahogany, Oak, Pine, SeaWood, Swamp, Walnut, White",
			"Default": "Bamboo",
			"Section": "Island Farm"
		},
		"Island Metal & Stone": {
			"AllowValues": "Classic, NonClassic, Light, Medium, Dark",
			"Default": "NonClassic",
			"Section": "Island Farm"
		},
		//Other
		"NoSeasonal": {
			"AllowValues": "true, false",
			"Default": "false",
			"Section": "Other"
		},
		"Use the Desaturated version?": {
			"AllowValues": "true, false",
			"Default": "false",
			"Section": "Other"
		},
		"Throw salt around the ShippingBin?": {
			"AllowValues": "true, false",
			"Default": "false",
			"Description": "to prevent evil ... and Snails: Snails will stop to appearing near the ShippingBin",
			"Section": "Other"
		}
	},

	//DynamicTokens
	"DynamicTokens": [
		{
			"Name": "Style",
			"Value": "{{ShippingBin Style}}"
		},
		{
			"Name": "IslandStyle",
			"Value": "{{Island ShippingBin Style}}"
		},
		{
			"Name": "IslandColor",
			"Value": "{{Island Metal & Stone}}"
		},
		{
			"Name": "DesaturatedOn",
			"Value": "{{Use the Desaturated version?}}"
		}
	],
	//End DynamicTokens

