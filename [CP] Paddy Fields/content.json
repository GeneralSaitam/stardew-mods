{
  "$schema": "https://smapi.io/schemas/content-patcher.json",
  "Format": "2.6.0",
  "ConfigSchema": {
    "PaddyColor": {
      "AllowValues": "auto, vanilla, muted",
      "Default": "auto"
    },
    "PassableCenterTile": {
      "AllowValues": "true, false",
      "Default": "false"
    }
  },
  "DynamicTokens": [
    {
      "Name": "Color",
      "Value": "{{PaddyColor}}"
    },
    {
      "Name": "Color",
      "Value": "vanilla",
      "When": {
        "PaddyColor": "auto"
      }
    },
    {
      "Name": "Color",
      "Value": "muted",
      "When": {
        "HasMod |contains=DaisyNiko.EarthyRecolour, grapeponta.VibrantPastoralRecolor, Lita.StarblueValley": true,
        "PaddyColor": "auto"
      }
    },
    {
      "Name": "CollisionMap",
      "Value": "X",
      "When": {
        "PassableCenterTile": false
      }
    },
    {
      "Name": "CollisionMap",
      "Value": "O",
      "When": {
        "PassableCenterTile": true
      }
    }
  ],
  "Changes": [
    /* These loads + edits can be changed to simply having more PNGs*/
    /* Choose to do this because it's easier to keep assets consistent*/
    {
      "LogName": "Paddy Loads",
      "Action": "Load",
      "Target": "{{ModId}}/paddy, {{ModId}}/paddy_bordered",
      "FromFile": "assets/{{Color}}/paddy.png"
    },
    {
      "LogName": "Paddy Edit - Blank",
      "Action": "EditImage",
      "Target": "{{ModId}}/paddy, {{ModId}}/paddy_bordered",
      "ToArea": {
        "X": 0,
        "Y": 16,
        "Width": 576,
        "Height": 16
      },
      "FromFile": "assets/{{Color}}/paddy.png",
      "FromArea": {
        "X": 0,
        "Y": 0,
        "Width": 576,
        "Height": 16
      },
      "When": {
        "PassableCenterTile": true
      }
    },
    {
      "LogName": "Paddy Edit - Add Border",
      "Action": "EditImage",
      "PatchMode": "Overlay",
      "Target": "{{ModId}}/paddy_bordered",
      "ToArea": {
        "X": 0,
        "Y": 32,
        "Width": 576,
        "Height": 144
      },
      "FromFile": "assets/paddy_border.png",
      "FromArea": {
        "X": 0,
        "Y": 0,
        "Width": 576,
        "Height": 144
      }
    },
    {
      "LogName": "Paddy Building Data",
      "Action": "EditData",
      "Target": "Data/Buildings",
      "Entries": {
        "{{ModId}}_Paddy": {
          "Name": "{{i18n:Paddy.Name}}",
          "Description": "{{i18n:Paddy.Description}}",
          "Texture": "{{ModId}}/paddy",
          "Skins": [
            {
              "Id": "Paddy_Bordered",
              "Name": "{{i18n:Paddy.Name}}",
              "Description": "{{i18n:Paddy.Description}}",
              "Texture": "{{ModId}}/paddy_bordered"
            }
          ],
          "DrawShadow": false,
          "UpgradeSignTile": "0, 0",
          "UpgradeSignHeight": 16.0,
          "Size": {
            "X": 1,
            "Y": 1
          },
          "FadeWhenBehind": false,
          "SourceRect": {
            "X": 0,
            "Y": 16,
            "Width": 16,
            "Height": 16
          },
          "SeasonOffset": {
            "X": 144,
            "Y": 0
          },
          "DrawOffset": "0, 0",
          "BuildMenuDrawOffset": {
            "X": 0,
            "Y": 0
          },
          "HumanDoor": {
            "X": -5,
            "Y": -5
          },
          "AnimalDoor": {
            "X": -5,
            "Y": -5,
            "Width": 0,
            "Height": 0
          },
          "SortTileOffset": 4000,
          "CollisionMap": "{{CollisionMap}}",
          "AdditionalPlacementTiles": [
            {
              "TileArea": {
                "X": -3,
                "Y": -3,
                "Width": 7,
                "Height": 7
              },
              "OnlyNeedsToBePassable": true
            }
          ],
          "Builder": "Robin",
          "BuildDays": 0,
          "BuildCost": 1000,
          "BuildMaterials": [
            {
              "ItemId": "(O)390",
              "Amount": 75
            }
          ],
          "MagicalConstruction": false,
          "AdditionalTilePropertyRadius": 3,
          "AllowsFlooringUnderneath": true,
          "TileProperties": [
            {
              "Id": "Default_Water",
              "Name": "Water",
              "Value": "T",
              "Layer": "Back",
              "TileArea": {
                "X": 0,
                "Y": 0,
                "Width": 1,
                "Height": 1
              }
            },
            {
              "Id": "Default_Diggable",
              "Name": "Diggable",
              "Value": "T",
              "Layer": "Back",
              "TileArea": {
                "X": -3,
                "Y": -3,
                "Width": 7,
                "Height": 7
              }
            },
            {
              "Id": "Default_Type_Dirt",
              "Name": "Type",
              "Value": "Dirt",
              "Layer": "Back",
              "TileArea": {
                "X": -3,
                "Y": -3,
                "Width": 7,
                "Height": 7
              }
            }
          ],
          "DrawLayers": [
            {
              "Id": "Default_PaddyDirt",
              "Texture": null,
              "SortTileOffset": 6000,
              "SourceRect": {
                "X": 0,
                "Y": 32,
                "Width": 144,
                "Height": 144
              },
              "DrawPosition": "-64, -64",
              "DrawInBackground": false
            },
          ]
        }
      }
    }
  ]
}