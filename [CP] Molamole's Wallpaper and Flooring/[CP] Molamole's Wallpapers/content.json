{
  "Format": "2.8.1",
  "ConfigSchema": {
    "Use the Desaturated version?": {
      "AllowValues": "true, false",
      "Default": "false"
    }
  },
    "DynamicTokens": [
      {
        "Name": "DesaturatedOn",
        "Value": "{{Use the Desaturated version?}}"
      }
    ],
  "Changes": [
    {
      "Action": "EditData",
      "Target": "Data/AdditionalWallpaperFlooring",
      "Entries": {
        "Molamole.Wallpaper.CP": {
          "ID": "Molamole.Wallpaper.CP",
          "Texture": "Mods/Molamole.Wallpaper.CP/MoleWallpapers",
          "IsFlooring": false,
          "Count": 1000
        }
      }
    },
    {
      "Action": "Load",
      "Target": "Mods/{{ModId}}//MoleWallpapers",
      "FromFile": "Assets/MoleWallpapers.png"
    },
    {
      "Action": "EditImage",
      "Target": "Mods/Molamole.Wallpaper.CP/MoleWallpapers",
      "FromFile": "Assets/MoleWallpapers - Desaturated.png",
      "PatchMode": "Replace",
      "When": {
        "DesaturatedOn": "true"
      }
    }
  ] 
}
