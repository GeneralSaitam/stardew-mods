//  "KatriellePath": "Pre-Meet, Pre-Reveal, Pre-Good, Good-End, Best-End, Bad-End, Samrielle-Start, Samrielle-Guitar, Samrielle-End",
  //Pre-Meet - Before 0-Heart Event
  //Pre-Reveal - Before 8-Heart Event to determine ending
  //Pre-Good - Between 1st and 2nd 8-Heart Events
  //Good-End - Good Ending, have not seen every heart event
  //Best-End - Best Ending, have seen every heart event
  //Bad-End - Bad Ending
  //Samrielle-Start - Has locked into Samrielle Path
  //Samrielle-Guitar - Has seen Samrielle Guitar event
  //Samrielle-End - Has seen the last Samrielle event
    {
      "Name": "KatriellePath",
      "Value": "Pre-Meet",
    },
    {
      "Name": "KatriellePath",
      "Value": "Pre-Reveal",
      "When": {
        "HasSeenEvent: anyPlayer |contains=999970": "true",
        "HasSeenEvent |contains=999976": "false",
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Bad-End",
      "When": {
        "HasSeenEvent |contains=999976": "true",
        "Query: (({{HasSeenEvent: anyPlayer |contains=999977}}) OR ({{HasSeenEvent: anyPlayer |contains=999978}}))": false,
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Pre-Good",
      "When": {
        "Query: (({{HasSeenEvent: anyPlayer |contains=999977}}) OR ({{HasSeenEvent: anyPlayer |contains=999978}}))": true,
        "HasSeenEvent: anyPlayer |contains=999979": "false",
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Good-End",
      "When": {
        "HasSeenEvent: anyPlayer |contains=999979": "true",
        "Query: (({{HasSeenEvent: anyPlayer |contains=999971}}) AND (({{HasSeenEvent: anyPlayer |contains=999972}}) OR ({{HasSeenEvent: anyPlayer |contains=999973}})) AND (({{HasSeenEvent: anyPlayer |contains=999974}}) OR ({{HasSeenEvent: anyPlayer |contains=999975}})))": false,
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Best-End",
      "When": {
        "HasSeenEvent: anyPlayer |contains=999979": "true",
        "Query: (({{HasSeenEvent: anyPlayer |contains=999971}}) AND (({{HasSeenEvent: anyPlayer |contains=999972}}) OR ({{HasSeenEvent: anyPlayer |contains=999973}})) AND (({{HasSeenEvent: anyPlayer |contains=999974}}) OR ({{HasSeenEvent: anyPlayer |contains=999975}})))": true,
        "Query: (({{HasSeenEvent: anyPlayer |contains=999954}}) OR ({{HasSeenEvent: anyPlayer |contains=999955}}))": false,
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Samrielle-Start",
      "When": {
        "Query: (({{HasSeenEvent: anyPlayer |contains=999954}}) OR ({{HasSeenEvent: anyPlayer |contains=999955}}))": true,
        "Query: ({{HasSeenEvent: anyPlayer |contains=999957}})": false,
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Samrielle-Guitar",
      "When": {
        "Query: ({{HasSeenEvent: anyPlayer |contains=999957}})": true,
        "Query: ({{HasSeenEvent: anyPlayer |contains=999958}})": false,
      },
    },
    {
      "Name": "KatriellePath",
      "Value": "Samrielle-End",
      "When": {
        "Query: ({{HasSeenEvent: anyPlayer |contains=999958}})": true,
      },
    },

