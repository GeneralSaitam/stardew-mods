  //★★★ カモメ系の編集(物置スペースの外観共通DT制御) ★★★
      {
        "Action": "EditMap",
        "Target": "Maps/Custom_Beach_Storage_Space",
        "FromFile": "assets/tmx/Beach_Storage_Space_Seagull.tmx",
        "MapTiles": [
          {
            "Position": { "X": "{{DT_Seagull_Log_Left_X}}", "Y": 7 }, //左
            "Layer": "Buildings",
            "SetProperties": {
              "Action": "Message \"BeachASSA04\""
            }
          },
          {
            "Position": { "X": 24, "Y": "{{DT_Seagull_Log_Under_Y}}" }, //下1
            "Layer": "Buildings",
            "SetProperties": {
              "Action": "Message \"BeachASSA04\""
            }
          },
          {
            "Position": { "X": 25, "Y": "{{DT_Seagull_Log_Under_Y}}" }, //下2
            "Layer": "Buildings",
            "SetProperties": {
              "Action": "Message \"BeachASSA04\""
            }
          }
        ],
        "When": {
          "Query: {{DT_Seagull_Query}}": "true",
          "LocationName": "Custom_Beach_Storage_Space",
        },
        "Update": "OnLocationChange, OnTimeChange"
      },


