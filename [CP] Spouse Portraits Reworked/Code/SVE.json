    "Changes": [
        //Precondition: SVE installed
        //Sophia
        {
            "Action": "EditImage",
            "Target": "Mods/FlashShifter.StardewValleyExpandedCP/SVE_Portraits",
            "FromFile": "Assets/{{PortraitRecolor}}/SVE/Sophia1.png",
            "PatchMode": "Replace",
            "ToArea": { "X": "0", "Y": "0", "Width": 32, "Height": 32},
        },

